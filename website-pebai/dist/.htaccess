# ==============================================================================
# PEBAI SYSTEMS - HIGH PERFORMANCE, EDGE CACHING & CRO REDIRECTS
# Dominio: pebaisystems.es
# ==============================================================================

# 0. Índice por defecto y resolución canónica de directorios
DirectoryIndex index.html index.php

# Página de error propia (en vez de la genérica de Hostinger en inglés)
ErrorDocument 404 /404.html

# 1. Redirecciones de Conversión Directa a WhatsApp (+34 624 84 27 99)
RewriteEngine On
RewriteBase /

# Dominio canónico: www.pebaisystems.es -> https://pebaisystems.es (301, conserva ruta y query).
# Solo se mira el host: el HTTPS lo termina Cloudflare y el origen puede ver HTTP, así que no se comprueba %{HTTPS} aquí (evita bucles).
RewriteCond %{HTTP_HOST} ^www\.pebaisystems\.es$ [NC]
RewriteRule ^(.*)$ https://pebaisystems.es/$1 [R=301,L]

# QRs de calle (puerta fría): /q/<nombre>?p=a|d → api/qr.php cuenta el escaneo y redirige (ver docs/enlaces-y-utm.md)
RewriteRule ^q/([a-z0-9-]+)/?$ api/qr.php?c=$1 [L,QSA]

# Resolución directa para las landings principales
RewriteRule ^consultoria-gratuita/?$ consultoria-gratuita/index.html [L]
RewriteRule ^confirmacion-de-llamada/?$ confirmacion-de-llamada/index.html [L]
RewriteRule ^formulario-completado/?$ formulario-completado/index.html [L]

# Redirección 302 para /contacto y /contact hacia WhatsApp oficial
RewriteRule ^contact(o)?/?$ "https://wa.me/34624842799?text=Hola%2C%20soy%20%5B%20x%20%5D%20vengo%20de%20la%20web%20con%20principal%20inter%C3%A9s%20en%20realizar%20una%20consultor%C3%ADa%20gratuita%20sin%20compromiso." [R=302,L]

# El VSL antiguo /sesion-estrategica/ (retirado el 15/10/2026) es ahora /consultoria-gratuita/
RewriteRule ^sesion-estrategica(/.*)?$ consultoria-gratuita/ [R=301,L,QSA]

# La portada de pruebas /nueva/ ya es la principal
RewriteRule ^nueva(/.*)?$ / [R=301,L]

# Enlaces cortos para perfiles y mensajes: llevan al VSL con el origen ya puesto (ver docs/enlaces-y-utm.md).
# Se puede añadir ?palabra=XXX (palabra clave de un Short) y se conserva (QSA).
RewriteRule ^ig/?$ consultoria-gratuita/?utm_source=instagram&utm_medium=bio [R=302,L,QSA,NE]
RewriteRule ^tt/?$ consultoria-gratuita/?utm_source=tiktok&utm_medium=bio [R=302,L,QSA,NE]
RewriteRule ^yt/?$ consultoria-gratuita/?utm_source=youtube&utm_medium=canal [R=302,L,QSA,NE]
RewriteRule ^fb/?$ consultoria-gratuita/?utm_source=facebook&utm_medium=bio [R=302,L,QSA,NE]
RewriteRule ^x/?$ consultoria-gratuita/?utm_source=x&utm_medium=bio [R=302,L,QSA,NE]
RewriteRule ^li/?$ consultoria-gratuita/?utm_source=linkedin&utm_medium=perfil [R=302,L,QSA,NE]
# Página de empresa de LinkedIn (botón y datos de interés)
RewriteRule ^li/empresa/?$ consultoria-gratuita/?utm_source=linkedin&utm_medium=empresa [R=302,L,QSA,NE]
RewriteRule ^li/geo/?$ posicionamiento-en-ia/?utm_source=linkedin&utm_medium=empresa [R=302,L,QSA,NE]
RewriteRule ^li/agentes/?$ agentes-ia/?utm_source=linkedin&utm_medium=empresa [R=302,L,QSA,NE]
# Tarjetas de visita (QR) para puerta fría: /t/adrian, /t/dani (ver assets/brand/pebai-systems/tarjetas/)
# /t/adrian y /t/dani son tarjetas digitales (carpetas en dist/t/): solo se redirige si no existe la carpeta
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^t/([a-z0-9-]+)/?$ consultoria-gratuita/?utm_source=tarjeta&utm_medium=puerta_fria&utm_content=$1 [R=302,L,NE]
RewriteRule ^t/?$ consultoria-gratuita/?utm_source=tarjeta&utm_medium=puerta_fria [R=302,L,NE]

# Vídeos largos de YouTube: /v/nombre-del-video (añade ?c=comentario para el comentario fijado)
RewriteCond %{QUERY_STRING} (^|&)c=comentario(&|$)
RewriteRule ^v/([a-z0-9-]+)/?$ consultoria-gratuita/?utm_source=youtube&utm_medium=video_largo&utm_campaign=$1&utm_content=comentario_fijado [R=302,L,NE]
RewriteRule ^v/([a-z0-9-]+)/?$ consultoria-gratuita/?utm_source=youtube&utm_medium=video_largo&utm_campaign=$1&utm_content=descripcion [R=302,L,NE]
RewriteRule ^wa/?$ consultoria-gratuita/?utm_source=whatsapp&utm_medium=mensaje [R=302,L,QSA,NE]

# Landings SEO retiradas el 15/10/2026 mientras se rehacen: 302 a la portada.
# Se desactiva sola en cuanto vuelve a existir la carpeta de cada una (RewriteCond !-d).
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(agencia-geo-generative-engine-optimization-espana|agencia-inteligencia-artificial-alicante|agencia-inteligencia-artificial-bilbao|agencia-inteligencia-artificial-cordoba|agencia-inteligencia-artificial-empresas-madrid|agencia-inteligencia-artificial-gijon|agencia-inteligencia-artificial-granada|agencia-inteligencia-artificial-malaga|agencia-inteligencia-artificial-murcia|agencia-inteligencia-artificial-palma-mallorca|agencia-inteligencia-artificial-santander|agencia-inteligencia-artificial-sevilla|agencia-inteligencia-artificial-toledo|agencia-inteligencia-artificial-valencia|agencia-inteligencia-artificial-valladolid|agencia-inteligencia-artificial-vigo|agencia-inteligencia-artificial-zaragoza|agente-de-ia-espana|agente-de-inteligencia-artificial-espana|agente-ia-clinicas-gestion-citas-telefonicas|agente-ia-cualificacion-leads-b2b|agente-ia-despachos-abogados-gestion-expedientes|agente-ia-distribucion-suministros-b2b|agente-ia-ecommerce-recomendacion-atencion|agente-ia-empresas-construccion-reformas|agente-ia-farmacias-parafarmacias-consultas-stock|agente-ia-hoteles-turismo-reservas|agente-ia-inmobiliarias-captacion-propiedades|agente-ia-logistica-optimizacion-rutas-stock|agente-ia-recursos-humanos-seleccion-personal|agente-ia-sap-business-one-espana|agente-ia-soporte-tecnico-nivel-1|agente-ia-talleres-automocion-postventa|agente-ia-whatsapp-business-api-empresas|agente-voz-atencion-telefonica-empresas|agentes-de-voz-ia-telefonicos-empresas|agentes-de-voz-ia-vs-call-center-subcontratado|agentes-inteligencia-artificial-empresas|auditoria-adopcion-inteligencia-artificial-negocio|auditoria-procesos-empresariales|automatizacion-facturas-pedidos-ia|automatizacion-factusol-pedidos-ia|automatizacion-procesos-n8n-empresas|chatbot-rag-documentacion-empresarial|como-posicionar-en-chatgpt-perplexity-gemini|consultoria-inteligencia-artificial-barcelona|consultoria-inteligencia-artificial-bilbao|consultoria-inteligencia-artificial-sevilla|consultoria-inteligencia-artificial-valencia|consultoria-procesos-inteligencia-artificial|cuanto-cuesta-implementar-inteligencia-artificial-empresa|cumplimiento-rgpd-ai-act-inteligencia-artificial|curso-inteligencia-artificial-para-empresas-espana|desarrollo-software-ia-a-medida-espana|empresa-de-inteligencia-artificial-espana|empresa-desarrollo-inteligencia-artificial-barcelona|empresas-automatizacion-procesos-espana|empresas-de-automatizacion-de-procesos-espana|empresas-de-inteligencia-artificial-espana|formacion-inteligencia-artificial-empresas|formacion-inteligencia-artificial-para-empresas-espana|integracion-ia-erp-crm-pymes|integracion-ia-holded-erp-espana|integracion-ia-sage-50-200-espana|migracion-procesos-antiguos-a-sistemas-ia|optimizacion-procesos-empresariales|optimizacion-procesos-industriales|programas-gestion-empresa-a-medida|reducir-costes-operativos-automatizacion-ia|roi-retorno-inversion-inteligencia-artificial|sistema-multiagente-ia-para-empresas|software-a-medida-para-empresas|zapier-vs-n8n-empresas-espana)(/.*)?$ / [R=302,L]

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Cabeceras de Rendimiento Extremo y Edge Caching
<IfModule mod_headers.c>
    # Las páginas se comprueban siempre con el servidor (responde 304 si no han cambiado),
    # para que nadie se quede con una versión vieja o con un error tras un despliegue.
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    <FilesMatch "\.(css|js|woff2|woff|ttf|png|jpg|jpeg|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Cabeceras de Seguridad y Privacidad
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Compresión GZIP / Brotli
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 4. Codificación de Caracteres por Defecto
AddDefaultCharset UTF-8

# Contacto descargable de PEBAI (formulario-completado)
AddType text/vcard .vcf
AddType text/calendar .ics
