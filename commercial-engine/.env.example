# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA COMERCIAL TRI-CANAL (PAI SYSTEMS / PEBAI SYSTEMS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AIRTABLE CRM CONFIGURATION
# ------------------------------------------------------------------------------
# Genera tu Personal Access Token (PAT) en: https://airtable.com/create/tokens
# SCOPES OBLIGATORIOS:
#   - data.records:read
#   - data.records:write
#   - schema.bases:read
# ACCESS:
#   - Selecciona la base "CRM Máster IA | Peñuelaballester"
AIRTABLE_PAT=pat_TU_TOKEN_NUEVO_AQUI
AIRTABLE_BASE_ID=appTU_BASE_ID_AQUI

# Nombres exactos de las tablas en Airtable
AIRTABLE_TABLE_PHYSICAL="🎯 Leads Físicos"
AIRTABLE_TABLE_ONLINE="🎯 Leads Full Online"
AIRTABLE_TABLE_MEETINGS="🤝 Reuniones & Cierre"

# ------------------------------------------------------------------------------
# 2. PROVEEDOR DE IA DE VOZ (Llamadas Salientes en Frío)
# ------------------------------------------------------------------------------
# Opciones soportadas: "vapi", "retell", "bland"
VOICE_AI_PROVIDER=retell

# Retell AI (https://www.retellai.com)
RETELL_API_KEY=key_tu_api_key_aqui
RETELL_AGENT_ID=agent_tu_agent_id_aqui
RETELL_FROM_NUMBER=+34XXXXXXXXX

# Vapi (https://vapi.ai)
VAPI_API_KEY=vapi_tu_api_key_aqui
VAPI_ASSISTANT_ID=asst_tu_assistant_id_aqui
VAPI_PHONE_NUMBER_ID=phone_id_aqui

# Bland AI (https://www.bland.ai)
BLAND_API_KEY=bland_tu_api_key_aqui
BLAND_PATHWAY_ID=pathway_id_aqui

# ------------------------------------------------------------------------------
# 3. PROVEEDOR DE WHATSAPP (Seguimiento Automático)
# ------------------------------------------------------------------------------
# Opciones soportadas: "evolution_api", "meta_cloud", "twilio"
WHATSAPP_PROVIDER=evolution_api

# Número comercial emisor / Adrián
COMMERCIAL_PHONE_SENDER=34624842799
ADRIAN_PHONE_ALERT=34624842799

# Evolution API (WhatsApp conectado directamente a tu teléfono)
EVOLUTION_API_URL=https://tu-instancia-evolution.com
EVOLUTION_API_KEY=tu_api_key_evolution
EVOLUTION_INSTANCE_NAME=pai_comercial

# Meta WhatsApp Cloud API (Oficial Meta for Developers)
META_WA_ACCESS_TOKEN=EAAG...
META_WA_PHONE_NUMBER_ID=1234567890
META_WA_BUSINESS_ACCOUNT_ID=0987654321

# Twilio (Alternativa)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ------------------------------------------------------------------------------
# 4. WEBHOOK & SERVIDOR LOCAL / PRODUCCIÓN
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WEBHOOK_SECRET_KEY=clave_secreta_para_validar_webhooks

# URL pública de este servidor (usar ngrok / cloudflare tunnel en desarrollo)
PUBLIC_BASE_URL=https://api.pebaisystems.com
