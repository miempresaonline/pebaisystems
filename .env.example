# PEBAI Systems - plantilla de variables. Copiar a .env y rellenar (.env nunca se sube).
# Despliegue SFTP en Hostinger (website-pebai/scripts/deploy*.py, sync_*.py)
HOSTINGER_SSH_HOST=
HOSTINGER_SSH_PORT=65002
HOSTINGER_SSH_USER=
HOSTINGER_SSH_PASS=
# Motor de carruseles (en GitHub Actions van como Secrets del repo)
GSHEET_WEBHOOK_URL=
GEMINI_API_KEY=
# Token compartido con website-pebai/api/send_alert.php y diagnostico.php
PEBAI_ALERT_TOKEN=

# Contraseña del panel de solicitudes (https://pebaisystems.es/panel/)
PANEL_PASSWORD=

# Agente de WhatsApp (agente-whatsapp/): token compartido con private/config.php ('agent_token') y número que envía (34XXXXXXXXX)
AGENT_TOKEN=
WA_NUMERO_AGENTE=
# Meta Ads: píxel (público), token de la API de Conversiones (va también a private/config.php 'meta' => capi_token)
# y acceso a la API de anuncios (usuario del sistema del Business Manager)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=

# Clave de Google Cloud (proyecto pebai-geo) para PageSpeed Insights, solo esa API (opcional)
PEBAI_PAGESPEED_KEY=

# Claude API (agentes del panel) y clave de administrador (gasto oficial, opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_WORKSPACE_ID=
