# ==============================================================================
# PEBAI SYSTEMS - .gitignore
# El repositorio es PUBLICO: nada de credenciales, datos de clientes ni sesiones.
# Las credenciales viven en .env (local) o en C:/programacion/APIs (fuera del repo).
# ==============================================================================

# --- Credenciales y secretos ---------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.token
*.pat
*.p12
*.pfx
id_rsa*
id_ed25519*
*_ed25519*
*service_account*.json
*credentials*.json
client_secret*.json
*cookies*.txt
*cookies*.json
secrets.local.*
privado/
.agents/mcp_config.json

# Configuración con claves que no debe versionarse
website-pebai/dist/api/instagram-config.php

# --- Datos personales, clientes y sesiones -------------------------------------
documentos/
leads*.csv
conversations_memory.json
learning_metrics.json
commercial-engine/backups/
assets/clients/
# Sesión de WhatsApp del agente y números contactados (solo en el servidor)
agente-whatsapp/sesion/
agente-whatsapp/contactados.json
agente-whatsapp/ultimos.json
agente-whatsapp/agente.pid
# Prospección: binarios descargados (scraper de gosom) y caché local
prospeccion/bin/
prospeccion/.cache/

# --- Zona de pruebas y material de terceros ------------------------------------
scratch/
archive/
tiktok_downloads/
carousel-engine/tiktok_inspect/
carousel-engine/knowledge/visual_vault/
carousel-engine/ig_dump.html

# Salidas generadas: solo se versionan los carruseles RAD-* que entrega GitHub Actions
carousel-engine/output/*
!carousel-engine/output/RAD-*/

# --- Python --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# --- Node ----------------------------------------------------------------------
node_modules/
npm-debug.log*

# --- Bases de datos y volcados -------------------------------------------------
*.sqlite
*.db
backups/
dump_*.json
dump_*.csv

# --- Media pesada y binarios ---------------------------------------------------
*.tar.gz
*.zip
*.mp4
*.mov
*.webm
*.wav
*.mp3

# --- Logs y SO -----------------------------------------------------------------
*.log
.DS_Store
Thumbs.db
desktop.ini

# Configuración privada del embudo (SMTP, panel)
website-pebai/private/*
!website-pebai/private/config.example.php

# Informes del modo Audit de design-motion-principles
motion-audits/

# Logos de las empresas de las demos: los guarda el servidor (agente Demos), no van al repositorio
website-pebai/dist/demos/
