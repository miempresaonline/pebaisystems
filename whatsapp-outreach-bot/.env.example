# ==============================================================================
# CONFIGURACIÓN DEL BOT DE PROSPECCIÓN WHATSAPP (PAI SYSTEMS)
# ==============================================================================

# Google Sheets (Deja en blanco para usar leads.csv local)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Leads
GOOGLE_SERVICE_ACCOUNT_PATH=C:/programacion/APIs/google_service_account.json

# Horario laboral de prospección (España peninsular)
# Mañana: 08:30 a 14:00
SCHEDULE_MORNING_START_HOUR=8
SCHEDULE_MORNING_START_MIN=30
SCHEDULE_MORNING_END_HOUR=14
SCHEDULE_MORNING_END_MIN=0

# Tarde: 16:00 a 19:30
SCHEDULE_AFTERNOON_START_HOUR=16
SCHEDULE_AFTERNOON_START_MIN=0
SCHEDULE_AFTERNOON_END_HOUR=19
SCHEDULE_AFTERNOON_END_MIN=30

# Permitir envíos en fin de semana (false recomendado)
ALLOW_WEEKENDS=false

# Cadencia humana anti-baneo (minutos de espera entre cada mensaje)
MIN_DELAY_MINUTES=8
MAX_DELAY_MINUTES=15

# Límite máximo de envíos diarios (los primeros días 25 a 40)
MAX_DAILY_MESSAGES=35

# Puerto para el mini panel web de vinculación QR (http://localhost:3000/qr)
PORT=3000

# Claves de Inteligencia Artificial para variación de mensajes
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Identidad de marca
SENDER_NAME=Adrián Peñuela
COMPANY_NAME=PAI Systems
WEBSITE_URL=https://pebaisystems.com

# Token para leer diagnostico.php de la web
PEBAI_ALERT_TOKEN=
