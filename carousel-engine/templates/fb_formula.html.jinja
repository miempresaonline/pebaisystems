<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ main_title|default("Growth Formula") }} - PEBAI Systems</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      width: 1080px;
      height: 1440px;
      background-color: #EFEDE7; /* Official PEBAI Mineral White */
      color: #12121A;
      font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 60px 65px;
      -webkit-font-smoothing: antialiased;
    }

    body::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(18, 18, 26, 0.05) 1.2px, transparent 0);
      background-size: 30px 30px;
      pointer-events: none;
      z-index: 1;
    }

    /* Header */
    .slide-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      position: relative;
      z-index: 2;
    }

    .badge-topic {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #555562;
    }

    .topic-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #B7FF3C;
      box-shadow: 0 0 10px #B7FF3C;
    }

    .slide-index {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: #12121A;
      background: rgba(18, 18, 26, 0.06);
      padding: 6px 14px;
      border-radius: 20px;
    }

    /* Hook Title */
    .hook-section {
      text-align: center;
      margin-top: 15px;
      position: relative;
      z-index: 2;
    }

    .tag-small {
      display: inline-block;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #6A5CFF;
      margin-bottom: 12px;
    }

    .main-title {
      font-size: 64px;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.08;
      text-transform: uppercase;
      color: #12121A;
    }

    .main-title span {
      color: #12121A;
      position: relative;
      display: inline-block;
    }

    .main-title span::after {
      content: "";
      position: absolute;
      left: -4px;
      right: -4px;
      bottom: 6px;
      height: 14px;
      background: #B7FF3C;
      z-index: -1;
      border-radius: 4px;
    }

    /* Formula Stack */
    .formula-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      width: 100%;
      max-width: 920px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .formula-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      gap: 16px;
    }

    .formula-card {
      flex: 1;
      background: #FFFFFF;
      border: 1.5px solid #12121A;
      border-radius: 22px;
      padding: 30px 24px;
      box-shadow: 0 8px 0 #12121A;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 14px;
    }

    .formula-icon {
      width: 64px;
      height: 64px;
      border-radius: 16px;
      background: #F1F0ED;
      border: 1px solid rgba(18, 18, 26, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .formula-icon svg {
      width: 34px;
      height: 34px;
    }

    .formula-info h3 {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #12121A;
    }

    .formula-info p {
      font-size: 15px;
      color: #646470;
      font-weight: 500;
      margin-top: 4px;
    }

    .operator-sign {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: #12121A;
      color: #B7FF3C;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      font-weight: 800;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(18, 18, 26, 0.2);
    }

    /* Result Card */
    .result-card {
      width: 100%;
      background: #12121A;
      border: 2px solid #B7FF3C;
      border-radius: 24px;
      padding: 32px 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 12px 0 #000000, 0 20px 50px rgba(183, 255, 60, 0.2);
    }

    .result-left {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .result-badge-icon {
      width: 72px;
      height: 72px;
      border-radius: 18px;
      background: #000000;
      border: 1.5px solid rgba(183, 255, 60, 0.35);
      padding: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .result-badge-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .result-text h3 {
      font-size: 28px;
      font-weight: 800;
      color: #FFFFFF;
      letter-spacing: -0.02em;
    }

    .result-text p {
      font-size: 17px;
      color: #B7FF3C;
      font-weight: 600;
      margin-top: 4px;
    }

    .result-metric {
      font-family: 'JetBrains Mono', monospace;
      font-size: 46px;
      font-weight: 800;
      color: #12121A;
      background: #B7FF3C;
      padding: 12px 28px;
      border-radius: 18px;
      box-shadow: 0 6px 20px rgba(183, 255, 60, 0.4);
      flex-shrink: 0;
    }

    /* Guarantee Bar */
    .guarantee-bar {
      display: flex;
      justify-content: space-around;
      width: 100%;
      max-width: 920px;
      margin: 0 auto;
      background: #FFFFFF;
      border: 1.5px solid #12121A;
      border-radius: 18px;
      padding: 18px 24px;
      box-shadow: 0 6px 0 #12121A;
      position: relative;
      z-index: 2;
    }

    .guar-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 17px;
      font-weight: 700;
      color: #12121A;
    }

    .guar-check {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #12121A;
      color: #B7FF3C;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 800;
    }

    /* Footer */
    .slide-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding-top: 24px;
      border-top: 1px solid rgba(18, 18, 26, 0.12);
      position: relative;
      z-index: 2;
    }

    .brand-id {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-id img {
      width: 32px;
      height: 32px;
      object-fit: contain;
    }

    .brand-name {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #12121A;
    }

    .brand-name span {
      font-weight: 400;
      color: #646470;
      margin-left: 4px;
    }

    .web-url {
      font-size: 18px;
      font-weight: 600;
      color: #555562;
    }

    .swipe-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #E2DFD7;
      padding: 10px 20px;
      border-radius: 24px;
      font-size: 16px;
      font-weight: 700;
      color: #12121A;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header class="slide-header">
    <div class="badge-topic">
      <div class="topic-dot"></div>
      <span>{{ topic_tag|default("FÓRMULA DE CRECIMIENTO · PEBAI") }}</span>
    </div>
    <div class="slide-index">{{ slide_number|default(1) }} / {{ total_slides|default(3) }}</div>
  </header>

  <!-- Hook Question -->
  <section class="hook-section">
    <span class="tag-small">{{ sub_tag|default("Escalabilidad de Ventas") }}</span>
    <h1 class="main-title">
      {{ title_line1|default("LA ECUACIÓN DE LAS EMPRESAS") }}<br><span>{{ title_highlight|default("QUE ESCALAN EN 2026") }}</span>
    </h1>
  </section>

  <!-- Visual Formula -->
  <section class="formula-stack">
    
    <div class="formula-row">
      <!-- Element 1 -->
      <div class="formula-card">
        <div class="formula-icon">
          {{ elem1_icon_svg|default('<svg viewBox="0 0 24 24" fill="none" stroke="#12121A" stroke-width="2.2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>')|safe }}
        </div>
        <div class="formula-info">
          <h3>{{ elem1_title|default("Agente de Voz 24/7") }}</h3>
          <p>{{ elem1_desc|default("Descuelga al 1er tono sin esperas") }}</p>
        </div>
      </div>

      <div class="operator-sign">+</div>

      <!-- Element 2 -->
      <div class="formula-card">
        <div class="formula-icon">
          {{ elem2_icon_svg|default('<svg viewBox="0 0 24 24" fill="none" stroke="#6A5CFF" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>')|safe }}
        </div>
        <div class="formula-info">
          <h3>{{ elem2_title|default("Pipeline n8n Privado") }}</h3>
          <p>{{ elem2_desc|default("Cualifica y envía presupuestos") }}</p>
        </div>
      </div>
    </div>

    <!-- Equal Sign -->
    <div class="operator-sign" style="font-size: 38px;">=</div>

    <!-- Hero Result Card -->
    <div class="result-card">
      <div class="result-left">
        <div class="result-badge-icon">
          <img src="{{ assets_uri }}/pebai/pebai-mark-color.svg" alt="PEBAI Logo">
        </div>
        <div class="result-text">
          <h3>{{ result_title|default("Sistema PEBAI Activo") }}</h3>
          <p>{{ result_desc|default("Reuniones de venta cerradas en automático") }}</p>
        </div>
      </div>
      <div class="result-metric">{{ result_metric|default("+35%") }}</div>
    </div>

  </section>

  <!-- 3 Guarantees -->
  <div class="guarantee-bar">
    {% for g in guarantees|default([
      {"text": "Cero contratos extra"},
      {"text": "Integrado en tu CRM"},
      {"text": "Operativo en 14 días"}
    ]) %}
    <div class="guar-item">
      <div class="guar-check">✓</div>
      <span>{{ g.text }}</span>
    </div>
    {% endfor %}
  </div>

  <!-- Slide Footer -->
  <footer class="slide-footer">
    <div class="brand-id">
      <img src="{{ assets_uri }}/pebai/pebai-horizontal-dark.svg" alt="PEBAI Systems" style="height: 32px; width: auto;">
    </div>
    <div class="web-url">{{ footer_web|default("pebaisystems.es") }}</div>
    <div class="swipe-pill">
      <span>{{ footer_cta|default("Desliza para ver el caso") }}</span>
      <span style="font-size: 18px;">&rarr;</span>
    </div>
  </footer>

</body>
</html>
