<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ title }} — Slide {{ slide_num }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@500;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    body {
      width: 1080px;
      height: 1440px;
      overflow: hidden;
      background: #FAF9F6;
      color: #0F172A;
      font-family: 'Plus Jakarta Sans', sans-serif;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 65px 95px 75px 75px;
    }

    .bg-dot-grid {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 1440px;
      background-image: radial-gradient(rgba(15, 23, 42, 0.08) 1.5px, transparent 1.5px);
      background-size: 28px 28px;
      pointer-events: none;
      z-index: 1;
    }

    .header-bar {
      position: relative;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }

    .brand-handle-pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #FFFFFF;
      border: 1.5px solid #E2E8F0;
      padding: 10px 22px;
      border-radius: 9999px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 15px;
      font-weight: 800;
      color: #0F172A;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    }

    .brand-handle-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #5848FA;
    }

    .category-tag-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13.5px;
      font-weight: 800;
      color: #5848FA;
      background: rgba(88, 72, 250, 0.08);
      border: 1px solid rgba(88, 72, 250, 0.2);
      padding: 6px 14px;
      border-radius: 6px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .brand-logo-img {
      height: 38px;
      width: auto;
      object-fit: contain;
    }

    .double-divider {
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, #5848FA 0%, #B7FF3C 70%, transparent 100%);
      margin-top: 14px;
      margin-bottom: 16px;
      border-radius: 2px;
    }

    .app-squircle {
      width: 58px;
      height: 58px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    }

    .app-squircle.sm {
      width: 44px;
      height: 44px;
      border-radius: 12px;
    }

    .app-squircle img {
      width: 65%;
      height: 65%;
      object-fit: contain;
    }

    .sq-openai { background: #10A37F; }
    .sq-perplexity { background: #1F2937; }
    .sq-google { background: #FFFFFF; border: 1.5px solid #E2E8F0; }
    .sq-pebai { background: #12121A; }

    .bottom-bar {
      position: relative;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      border-top: 1.5px solid #E2E8F0;
      padding-top: 16px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14.5px;
      color: #64748B;
      font-weight: 600;
    }

    .progress-track {
      display: flex;
      gap: 7px;
      align-items: center;
    }

    .progress-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #CBD5E1;
    }

    .progress-dot.active {
      width: 26px;
      height: 8px;
      border-radius: 4px;
      background: #5848FA;
    }

    .washi-note {
      position: absolute;
      background: #FFFFFF;
      border: 1.5px solid #E2E8F0;
      border-radius: 14px;
      padding: 16px 20px;
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
      z-index: 20;
    }

    .washi-tape {
      position: absolute;
      top: -10px;
      left: 30%;
      width: 70px;
      height: 20px;
      background: rgba(226, 232, 240, 0.85);
      border-left: 2px dashed rgba(100, 116, 139, 0.4);
      border-right: 2px dashed rgba(100, 116, 139, 0.4);
    }
  </style>
</head>
<body>
  <div class="bg-dot-grid"></div>

  <!-- HEADER -->
  <header class="header-bar">
    <div class="brand-handle-pill">
      <span class="brand-handle-dot"></span>
      <span>@pebaisystems</span>
    </div>
    <div class="category-tag-badge">{{ category_tag }}</div>
    <img src="{{ pebai_logo_horizontal }}" alt="PEBAI Systems" class="brand-logo-img">
  </header>

  {% if slide_num == 1 %}
  <!-- SLIDE 1: PORTADA MIXTO GEO (AI SEARCH / CITATION MOCKUP) -->
  <main style="position: relative; z-index: 10; margin-top: 15px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
    
    <!-- WASHI STICKER -->
    <div class="washi-note" style="top: -5px; right: 0; transform: rotate(1.5deg);">
      <div class="washi-tape"></div>
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 800; color: #5848FA; letter-spacing: 0.08em; text-transform: uppercase;">ALGORITMO 2026</div>
      <div style="font-size: 15px; font-weight: 700; color: #0F172A; margin-top: 2px;">ChatGPT & Perplexity</div>
    </div>

    <!-- MAIN HEADLINE -->
    <div style="max-width: 670px;">
      <h2 style="font-family: 'Instrument Serif', Georgia, serif; font-size: 58px; font-weight: 400; color: #0F172A; line-height: 1.05;">
        La gente ya no busca en Google:
      </h2>
      <h1 style="font-size: 80px; font-weight: 900; line-height: 0.95; letter-spacing: -0.04em; background: linear-gradient(135deg, #5848FA 0%, #12121A 75%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-transform: uppercase; margin-top: 6px;">
        Le Pregunta a la IA
      </h1>
      <div class="double-divider"></div>
      <p style="font-size: 25px; color: #334155; line-height: 1.35; font-weight: 600; margin-top: 6px;">
        7 de cada 10 personas ya no entran a páginas web: le piden recomendaciones directas a ChatGPT o Perplexity. Si la IA no conoce tu empresa, eres invisible.
      </p>
    </div>

    <!-- BESPOKE VISUAL CENTERPIECE: MOTOR GENERATIVO CON CITACIÓN RECOMENDADA -->
    <div style="background: #FFFFFF; border: 2px solid #E2E8F0; border-radius: 24px; padding: 24px 28px; box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08); display: flex; flex-direction: column; gap: 16px;">
      
      <!-- PERPLEXITY / CHATGPT SEARCH BAR -->
      <div style="background: #F8FAFC; border: 1.5px solid #CBD5E1; border-radius: 14px; padding: 14px 20px; display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div class="app-squircle sm sq-perplexity" style="width: 36px; height: 36px;">
            <img src="{{ logos.perplexity }}" alt="Search">
          </div>
          <span style="font-size: 20px; font-weight: 700; color: #0F172A;">
            "¿Qué empresa me recomiendas para [Tu Servicio] en España?"
          </span>
        </div>
        <span style="background: #12121A; color: #B7FF3C; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 800; padding: 4px 10px; border-radius: 6px;">
          PREGUNTA REAL
        </span>
      </div>

      <!-- CITATION CARD (EMPRESA OPTIMIZADA CON GEO PEBAI) -->
      <div style="background: linear-gradient(135deg, rgba(88, 72, 250, 0.08) 0%, rgba(183, 255, 60, 0.12) 100%); border: 2px solid #5848FA; border-radius: 18px; padding: 20px 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="background: #5848FA; color: #FFFFFF; font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 900; padding: 4px 10px; border-radius: 6px;">
              TU EMPRESA (CON GEO)
            </span>
            <span style="font-size: 17px; font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #5848FA;">
              pebaisystems.es
            </span>
          </div>
          <span style="background: #B7FF3C; color: #12121A; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 900; padding: 4px 12px; border-radius: 6px;">
            RECOMENDADO #1
          </span>
        </div>
        <p style="font-size: 22px; color: #0F172A; font-weight: 700; line-height: 1.4; margin-top: 10px;">
          "Para ese servicio en España, te recomiendo PEBAI Systems: es la firma destacada por sus sistemas avanzados y soporte rápido..."
        </p>
        <div style="margin-top: 10px; font-family: 'JetBrains Mono', monospace; font-size: 16px; font-weight: 800; color: #16A34A;">
          ➔ Resultado: El cliente te contacta y te compra a ti
        </div>
      </div>

      <!-- NO-GEO CARD (COMPETIDOR INVISIBLE) -->
      <div style="background: #F8FAFC; border: 1.5px dashed #CBD5E1; border-radius: 14px; padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; opacity: 0.85;">
        <div>
          <div style="font-size: 19px; color: #0F172A; font-weight: 800;">
            Tu competencia (sin arquitectura GEO):
          </div>
          <div style="font-size: 16px; color: #64748B; margin-top: 2px;">
            Tienen web bonita pero la IA ni sabe que existen.
          </div>
        </div>
        <span style="background: rgba(239, 68, 68, 0.1); color: #EF4444; font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 800; padding: 6px 12px; border-radius: 8px;">
          0 VENTAS · NO APARECEN
        </span>
      </div>

      <!-- CAVEAT HANDWRITTEN NOTE -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2px;">
        <span style="font-family: 'Caveat', cursive; font-size: 34px; font-weight: 700; color: #5848FA;">
          O te recomienda la IA, o te vuelves invisible ➔
        </span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 15px; font-weight: 700; color: #64748B;">
          Desliza para ver cómo se hace
        </span>
      </div>
    </div>

    <!-- METRIC BANNER -->
    <div style="background: #FFFFFF; border: 1.5px solid #E2E8F0; border-radius: 16px; padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);">
      <div style="display: flex; align-items: center; gap: 14px;">
        <span style="width: 12px; height: 12px; border-radius: 50%; background: #5848FA;"></span>
        <span style="font-size: 22px; font-weight: 800; color: #0F172A;">7 de cada 10 búsquedas terminan en la IA sin entrar a Google</span>
      </div>
      <span style="font-size: 20px; font-weight: 700; color: #5848FA;">GEO: El nuevo posicionamiento</span>
    </div>
  </main>

  {% elif slide_num == 2 %}
  <!-- SLIDE 2: POR QUÉ EL SEO TRADICIONAL YA NO FUNCIONA -->
  <main style="position: relative; z-index: 10; margin-top: 15px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
    <div class="washi-note" style="top: -10px; right: 0; transform: rotate(-1.5deg);">
      <div class="washi-tape"></div>
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 800; color: #5848FA;">CAMBIO DE PARADIGMA</div>
      <div style="font-size: 15px; font-weight: 700; color: #0F172A;">2018 vs 2026</div>
    </div>

    <div style="max-width: 720px;">
      <h2 style="font-family: 'Instrument Serif', Georgia, serif; font-size: 68px; font-weight: 400; color: #0F172A; line-height: 1.0;">
        Por Qué el SEO
      </h2>
      <h1 style="font-size: 78px; font-weight: 800; line-height: 0.95; letter-spacing: -0.03em; color: #0F172A; text-transform: uppercase; margin-top: 4px;">
        De Enlaces Ha Muerto
      </h1>
      <div class="double-divider" style="margin-top: 12px; margin-bottom: 20px;"></div>
    </div>

    <!-- COMPARISON STACK -->
    <div style="display: flex; flex-direction: column; gap: 18px;">
      
      <!-- CARD SEO 2018 -->
      <div style="background: #FFFFFF; border: 1.5px solid #E2E8F0; border-radius: 18px; padding: 22px 26px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05); display: grid; grid-template-columns: 58px 1fr; gap: 20px; align-items: flex-start; opacity: 0.85;">
        <div class="app-squircle sq-google">
          <img src="{{ logos.google }}" alt="Google SEO">
        </div>
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 26px; font-weight: 800; color: #64748B;">SEO Antiguo: 10 Enlaces Azules</h3>
            <span style="background: rgba(239, 68, 68, 0.1); color: #EF4444; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 800; padding: 4px 10px; border-radius: 6px;">EN DECLIVE</span>
          </div>
          <p style="font-size: 22px; color: #475569; margin-top: 6px; line-height: 1.45;">
            Se basaba en meter palabras clave en artículos de blog y comprar enlaces externos. El usuario tenía que pinchar en tu web para leerte.
          </p>
        </div>
      </div>

      <!-- CARD GEO 2026 -->
      <div style="background: linear-gradient(135deg, rgba(88, 72, 250, 0.04) 0%, rgba(183, 255, 60, 0.1) 100%); border: 2px solid #5848FA; border-radius: 18px; padding: 22px 26px; box-shadow: 0 10px 30px rgba(88, 72, 250, 0.08); display: grid; grid-template-columns: 58px 1fr; gap: 20px; align-items: flex-start;">
        <div class="app-squircle sq-perplexity">
          <img src="{{ logos.perplexity }}" alt="GEO">
        </div>
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 28px; font-weight: 800; color: #0F172A;">GEO 2026: Convertirte en la Respuesta</h3>
            <span style="background: #12121A; color: #B7FF3C; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 900; padding: 4px 10px; border-radius: 6px;">EL ESTÁNDAR</span>
          </div>
          <p style="font-size: 22px; color: #334155; margin-top: 6px; line-height: 1.45;">
            El usuario pregunta a ChatGPT, Gemini o Perplexity y lee una única síntesis. Si la IA no cita tu marca como fuente de referencia contrastada, no existes.
          </p>
        </div>
      </div>

      <!-- TAKEAWAY CARD -->
      <div style="background: #FFFFFF; border: 1.5px solid #E2E8F0; border-radius: 18px; padding: 20px 24px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);">
        <div style="font-size: 18px; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #5848FA;">LA NUEVA MÉTRICA: "SHARE OF MODEL"</div>
        <p style="font-size: 22px; color: #0F172A; font-weight: 700; margin-top: 4px;">
          Ya no compites por el ranking #1 de Google. Compites por el porcentaje de veces que la IA te menciona como la mejor opción de tu sector.
        </p>
      </div>
    </div>

    <!-- BOTTOM ROW -->
    <div style="background: #FFFFFF; border: 1.5px solid rgba(88, 72, 250, 0.2); border-radius: 16px; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between;">
      <span style="font-size: 22px; font-weight: 700; color: #0F172A;">
        ¿Cómo decide la IA a quién citar?
      </span>
      <span style="font-family: 'Caveat', cursive; font-size: 34px; font-weight: 700; color: #5848FA;">Los 3 pilares del algoritmo →</span>
    </div>
  </main>

  {% elif slide_num == 3 %}
  <!-- SLIDE 3: PASO 1: LOS 3 PILARES DEL ALGORITMO GEO -->
  <main style="position: relative; z-index: 10; margin-top: 15px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
    <div class="washi-note" style="top: -10px; right: 0; transform: rotate(1deg);">
      <div class="washi-tape"></div>
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 800; color: #5848FA;">ARQUITECTURA TÉCNICA</div>
      <div style="font-size: 15px; font-weight: 700; color: #0F172A;">Cómo lee un LLM</div>
    </div>

    <div style="max-width: 720px;">
      <h2 style="font-family: 'Instrument Serif', Georgia, serif; font-size: 68px; font-weight: 400; color: #0F172A; line-height: 1.0;">
        Paso 1: Los 3 Pilares
      </h2>
      <h1 style="font-size: 78px; font-weight: 800; line-height: 0.95; letter-spacing: -0.03em; color: #0F172A; text-transform: uppercase; margin-top: 4px;">
        Del Algoritmo GEO
      </h1>
      <div class="double-divider" style="margin-top: 12px; margin-bottom: 20px;"></div>
    </div>

    <!-- 3 PILLARS BENTO -->
    <div style="display: flex; flex-direction: column; gap: 18px;">
      
      <!-- PILLAR 1 -->
      <div style="background: #FFFFFF; border: 1.5px solid #E2E8F0; border-radius: 18px; padding: 22px 26px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05); display: flex; gap: 20px; align-items: flex-start;">
        <div class="app-squircle sq-pebai">
          <img src="{{ logos.python }}" alt="llms.txt">
        </div>
        <div>
          <h3 style="font-size: 28px; font-weight: 800; color: #0F172A;">1. Archivos `llms.txt` y Markdown Limpio</h3>
          <p style="font-size: 22px; color: #475569; margin-top: 6px; line-height: 1.45;">
            Los bots de IA no ejecutan JavaScript pesado. Necesitan catálogos y fichas en Markdown puro que se puedan parsear en menos de 30 milisegundos.
          </p>
        </div>
      </div>

      <!-- PILLAR 2 -->
      <div style="background: #FFFFFF; border: 1.5px solid #E2E8F0; border-radius: 18px; padding: 22px 26px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05); display: flex; gap: 20px; align-items: flex-start;">
        <div class="app-squircle sq-openai">
          <img src="{{ logos.openai }}" alt="Entidad">
        </div>
        <div>
          <h3 style="font-size: 28px; font-weight: 800; color: #0F172A;">2. Validación de Entidades y Citación Cruzada</h3>
          <p style="font-size: 22px; color: #475569; margin-top: 6px; line-height: 1.45;">
            El modelo cruza información de tu marca con bases de datos públicas, prensa y registros oficiales para confirmar que eres una fuente de verdad sin sesgo.
          </p>
        </div>
      </div>

      <!-- PILLAR 3 -->
      <div style="background: #FFFFFF; border: 1.5px solid #E2E8F0; border-radius: 18px; padding: 22px 26px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05); display: flex; gap: 20px; align-items: flex-start;">
        <div class="app-squircle sq-perplexity">
          <img src="{{ logos.perplexity }}" alt="WAF">
        </div>
        <div>
          <h3 style="font-size: 28px; font-weight: 800; color: #0F172A;">3. Bypass Prioritario en Cloudflare WAF</h3>
          <p style="font-size: 22px; color: #475569; margin-top: 6px; line-height: 1.45;">
            El 70% de las webs bloquean por error a <span style="font-family: 'JetBrains Mono', monospace; font-size: 19px; color: #5848FA;">OAI-SearchBot</span> y <span style="font-family: 'JetBrains Mono', monospace; font-size: 19px; color: #5848FA;">PerplexityBot</span>. Es obligatorio abrir rutas directas en el servidor Edge.
          </p>
        </div>
      </div>
    </div>

    <!-- BOTTOM ROW -->
    <div style="background: #FFFFFF; border: 1.5px solid rgba(88, 72, 250, 0.2); border-radius: 16px; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between;">
      <span style="font-size: 22px; font-weight: 700; color: #0F172A;">
        Así es como PEBAI ejecuta el servicio de GEO para marcas.
      </span>
      <span style="font-family: 'Caveat', cursive; font-size: 34px; font-weight: 700; color: #5848FA;">Ver el proceso →</span>
    </div>
  </main>

  {% elif slide_num == 4 %}
  <!-- SLIDE 4: PASO 2: EL SERVICIO GEO DE PEBAI SYSTEMS -->
  <main style="position: relative; z-index: 10; margin-top: 15px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
    <div class="washi-note" style="top: -10px; right: 0; transform: rotate(-2deg);">
      <div class="washi-tape"></div>
      <div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 800; color: #5848FA;">MÉTODO PEBAI</div>
      <div style="font-size: 15px; font-weight: 700; color: #0F172A;">Implementación integral</div>
    </div>

    <div style="max-width: 720px;">
      <h2 style="font-family: 'Instrument Serif', Georgia, serif; font-size: 68px; font-weight: 400; color: #0F172A; line-height: 1.0;">
        Paso 2: Cómo lo
      </h2>
      <h1 style="font-size: 78px; font-weight: 800; line-height: 0.95; letter-spacing: -0.03em; color: #0F172A; text-transform: uppercase; margin-top: 4px;">
        Hacemos en PEBAI
      </h1>
      <div class="double-divider" style="margin-top: 12px; margin-bottom: 20px;"></div>
    </div>

    <!-- 3 SERVICE PHASES -->
    <div style="display: flex; flex-direction: column; gap: 18px;">
      
      <div style="background: #FFFFFF; border: 1.5px solid #E2E8F0; border-radius: 18px; padding: 22px 26px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05); display: flex; gap: 20px; align-items: flex-start;">
        <div style="background: rgba(88, 72, 250, 0.1); color: #5848FA; font-family: 'JetBrains Mono', monospace; font-size: 20px; font-weight: 900; width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          01
        </div>
        <div>
          <h3 style="font-size: 28px; font-weight: 800; color: #0F172A;">Auditoría de Cuota de Mención (Share of Model)</h3>
