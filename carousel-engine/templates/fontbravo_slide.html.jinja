<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ category_title }} - PEBAI Systems</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      width: 1080px;
      height: 1440px;
      background-color: #EFEDE7;
      color: #12121A;
      font-family: 'Manrope', -apple-system, sans-serif;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 85px 80px 65px 80px;
      -webkit-font-smoothing: antialiased;
    }

    .noise-overlay {
      position: absolute;
      inset: 0;
      opacity: 0.045;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      z-index: 10;
    }

    /* Top Pagination Pill */
    .top-meta {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 2;
      margin-bottom: 10px;
    }

    .meta-tag {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #55545E;
    }

    .meta-pagination {
      font-size: 14px;
      font-weight: 700;
      color: #55545E;
      background: #E5E2DA;
      padding: 6px 14px;
      border-radius: 20px;
    }

    /* Header */
    .header-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      z-index: 2;
    }

    .category-icon {
      width: 46px;
      height: 46px;
      margin-bottom: 20px;
      stroke: #12121A;
      stroke-width: 1.8;
      fill: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .category-icon svg {
      width: 100%;
      height: 100%;
    }

    .main-title {
      font-size: 72px;
      font-weight: 800;
      letter-spacing: -0.045em;
      line-height: 1.05;
      text-transform: uppercase;
      color: #12121A;
      max-width: 900px;
    }

    /* Chart */
    .chart-container {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      z-index: 2;
      margin-top: 30px;
    }

    .bars-wrapper {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 48px;
      width: 100%;
      height: 770px;
    }

    .bar-column {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 235px;
      height: 100%;
      justify-content: flex-end;
    }

    .rating-label {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 20px;
      color: #12121A;
    }

    .rating-label.hero-rating {
      display: flex;
      align-items: center;
      gap: 6px;
      color: #12121A;
    }

    .pill-bar {
      width: 100%;
      border-radius: 118px 118px 0 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 36px;
      position: relative;
    }

    .pill-bar.is-hero {
      box-shadow: 0 25px 60px rgba(183, 255, 60, 0.35);
    }

    .pill-icon {
      width: 68px;
      height: 68px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .pill-icon svg {
      width: 100%;
      height: 100%;
    }

    /* High contrast dark badge for PEBAI logo inside lime pillar */
    .brand-hero-badge {
      width: 86px;
      height: 86px;
      background: #12121A;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 24px rgba(18, 18, 26, 0.22);
      padding: 18px;
    }

    .brand-hero-badge img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .baseline-line {
      width: 860px;
      height: 4px;
      background-color: #12121A;
      border-radius: 2px;
    }

    .labels-wrapper {
      display: flex;
      justify-content: center;
      gap: 48px;
      width: 100%;
      margin-top: 22px;
    }

    .tool-label {
      width: 235px;
      text-align: center;
      font-size: 29px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #12121A;
    }

    .tool-label.highlight {
      font-weight: 800;
    }

    /* Footer */
    .footer-section {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid rgba(18, 18, 26, 0.12);
      padding-top: 30px;
      z-index: 2;
    }

    .footer-brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .footer-brand img {
      width: 32px;
      height: 32px;
      object-fit: contain;
    }

    .footer-name {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #12121A;
    }

    .footer-note {
      font-size: 18px;
      font-weight: 500;
      color: #55545E;
    }

    .footer-cta {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 16px;
      font-weight: 700;
      color: #12121A;
      background: #E5E2DA;
      padding: 10px 20px;
      border-radius: 30px;
      border: 1px solid #C6C3BB;
    }
  </style>
</head>
<body>
  <div class="noise-overlay"></div>

  <!-- Meta Pagination -->
  <div class="top-meta">
    <span class="meta-tag">AUDITORÍA VISUAL · PEBAI</span>
    {% if slide_number and total_slides %}
    <span class="meta-pagination">{{ slide_number }}/{{ total_slides }}</span>
    {% endif %}
  </div>

  <!-- Header -->
  <div class="header-container">
    <div class="category-icon">
      {{ category_icon_svg|safe }}
    </div>
    <h1 class="main-title">{{ category_title }}</h1>
  </div>

  <!-- Chart Columns -->
  <div class="chart-container">
    <div class="bars-wrapper">
      {% for col in columns %}
      <div class="bar-column">
        <span class="rating-label {% if col.is_hero %}hero-rating{% endif %}">{{ col.rating }}</span>
        <div class="pill-bar {% if col.is_hero %}is-hero{% endif %}" style="height: {{ col.height_px }}px; background-color: {{ col.bg_color }};">
          {% if col.is_hero or col.icon == 'pebai' %}
          <div class="brand-hero-badge">
            <img src="{{ assets_uri }}/pebai/pebai-mark-color.svg" alt="PEBAI Logo">
          </div>
          {% else %}
          <div class="pill-icon">
            {{ col.icon_svg|safe }}
          </div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="baseline-line"></div>

    <div class="labels-wrapper">
      {% for col in columns %}
      <div class="tool-label {% if col.is_hero %}highlight{% endif %}">{{ col.name }}</div>
      {% endfor %}
    </div>
  </div>

  <!-- Footer -->
  <div class="footer-section">
    <div class="footer-brand">
      <img src="{{ assets_uri }}/pebai/pebai-horizontal-dark.svg" alt="PEBAI Systems">
    </div>
    <div class="footer-note">{{ footer_text|default("pebaisystems.es") }}</div>
    <div class="footer-cta">
      <span>{{ footer_cta|default("Desliza para ver el stack") }}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#12121A" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>
  </div>
</body>
</html>
