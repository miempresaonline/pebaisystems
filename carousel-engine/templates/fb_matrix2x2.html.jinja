<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ title_line1 }} - PEBAI Systems</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      width: 1080px;
      height: 1440px;
      background-color: #EFEDE7;
      color: #12121A;
      font-family: 'Manrope', -apple-system, sans-serif;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 70px 75px 55px 75px;
      -webkit-font-smoothing: antialiased;
    }

    .noise-overlay {
      position: absolute;
      inset: 0;
      opacity: 0.045;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      z-index: 10;
    }

    .top-meta {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 2;
    }

    .meta-tag {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #55545E;
    }

    .meta-pagination {
      font-size: 13px;
      font-weight: 800;
      color: #12121A;
      background: #E2DFD6;
      padding: 6px 14px;
      border-radius: 20px;
    }

    .header-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      z-index: 2;
      margin-top: 15px;
    }

    .category-icon-pill {
      width: 48px;
      height: 48px;
      background: #12121A;
      color: #B7FF3C;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      padding: 10px;
    }

    .category-icon-pill svg {
      width: 100%;
      height: 100%;
    }

    .main-title {
      font-size: 54px;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.08;
      text-transform: uppercase;
      color: #12121A;
      max-width: 900px;
    }

    .main-title span.highlight {
      color: #594AF7;
    }

    /* 2x2 Matrix Container */
    .matrix-wrapper {
      width: 100%;
      position: relative;
      z-index: 2;
      margin-top: 20px;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      padding-left: 34px;
      box-sizing: border-box;
    }

    /* Axis Labels */
    .axis-y-label {
      position: absolute;
      left: -80px;
      top: 48%;
      transform: translateY(-50%) rotate(-90deg);
      transform-origin: center center;
      white-space: nowrap;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #71707B;
    }

    .matrix-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 20px;
      width: 100%;
      height: 720px;
    }

    .quadrant-card {
      background: #FFFFFF;
      border: 1px solid #D8D4C8;
      border-radius: 24px;
      padding: 32px 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      box-shadow: 0 4px 14px rgba(18, 18, 26, 0.04);
    }

    .quadrant-card.hero-quadrant {
      background: #12121A;
      color: #FFFFFF;
      border: 2px solid #B7FF3C;
      box-shadow: 0 20px 50px rgba(18, 18, 26, 0.25), 0 0 30px rgba(183, 255, 60, 0.18);
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .quadrant-badge {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 6px 12px;
      border-radius: 8px;
      background: #F1EFEA;
      color: #55545E;
    }

    .hero-quadrant .quadrant-badge {
      background: rgba(183, 255, 60, 0.18);
      color: #B7FF3C;
      border: 1px solid rgba(183, 255, 60, 0.4);
    }

    .card-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: #F3F1EC;
      color: #12121A;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 8px;
    }

    .hero-quadrant .card-icon {
      background: rgba(183, 255, 60, 0.2);
      color: #B7FF3C;
    }

    .card-icon svg {
      width: 100%;
      height: 100%;
    }

    .card-middle {
      margin-top: 15px;
    }

    .quadrant-title {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: #12121A;
      margin-bottom: 8px;
    }

    .hero-quadrant .quadrant-title {
      color: #FFFFFF;
    }

    .quadrant-desc {
      font-size: 15px;
      font-weight: 500;
      color: #55545E;
      line-height: 1.35;
    }

    .hero-quadrant .quadrant-desc {
      color: #B5B3BE;
    }

    .card-bottom {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid #EAE7DF;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .hero-quadrant .card-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .metric-chip {
      font-size: 18px;
      font-weight: 800;
      color: #12121A;
      letter-spacing: -0.01em;
    }

    .hero-quadrant .metric-chip {
      color: #B7FF3C;
      font-size: 20px;
    }

    .metric-sub {
      font-size: 12px;
      font-weight: 700;
      color: #71707B;
      text-transform: uppercase;
    }

    .hero-quadrant .metric-sub {
      color: #9A97A6;
    }

    .axis-x-label {
      width: 100%;
      display: flex;
      justify-content: space-between;
      margin-top: 12px;
      padding: 0 10px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #71707B;
    }

    /* Footer */
    .footer-section {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 2;
      border-top: 1.5px solid #D8D4C8;
      padding-top: 24px;
    }

    .footer-brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .footer-brand img {
      height: 32px;
      width: auto;
    }

    .footer-note {
      font-size: 13px;
      font-weight: 700;
      color: #71707B;
    }

    .footer-cta {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 800;
      color: #12121A;
      background: #FFFFFF;
      padding: 10px 18px;
      border-radius: 30px;
      border: 1px solid #D8D4C8;
    }
  </style>
</head>
<body>
  <div class="noise-overlay"></div>

  <!-- Meta Pagination -->
  <div class="top-meta">
    <span class="meta-tag">{{ topic_tag|default("MATRIZ ESTRATÉGICA · PEBAI") }}</span>
    {% if slide_number and total_slides %}
    <span class="meta-pagination">{{ slide_number }}/{{ total_slides }}</span>
    {% endif %}
  </div>

  <!-- Header -->
  <div class="header-container">
    <div class="category-icon-pill">
      {{ category_icon_svg|safe }}
    </div>
    <h1 class="main-title">{{ title_line1 }} <span class="highlight">{{ title_highlight }}</span></h1>
  </div>

  <!-- 2x2 Matrix -->
  <div class="matrix-wrapper">
    <div class="axis-y-label">Velocidad de Respuesta ↑</div>
    <div class="matrix-grid">
      <!-- Q1: Top-Left (Costoso / Tradicional Saturado) -->
      <div class="quadrant-card">
        <div class="card-top">
          <span class="quadrant-badge">{{ q1_badge|default("Saturado") }}</span>
          <div class="card-icon">{{ q1_icon_svg|safe }}</div>
        </div>
        <div class="card-middle">
          <h3 class="quadrant-title">{{ q1_title|default("Secretaría en Horario") }}</h3>
          <p class="quadrant-desc">{{ q1_desc|default("Líneas comunicando y llamadas a deshora que nadie descuelga.") }}</p>
        </div>
        <div class="card-bottom">
          <div>
            <div class="metric-chip">{{ q1_metric|default("4 Horas") }}</div>
            <div class="metric-sub">{{ q1_metric_sub|default("Espera") }}</div>
          </div>
          <div style="font-size: 12px; font-weight: 700; color: #a81b1b;">Alto coste fijo</div>
        </div>
      </div>

      <!-- Q2: Top-Right (HERO: Agente PEBAI) -->
      <div class="quadrant-card hero-quadrant">
        <div class="card-top">
          <span class="quadrant-badge">{{ q2_badge|default("LÍDER OPERATIVO") }}</span>
          <div class="card-icon">{{ q2_icon_svg|safe }}</div>
        </div>
        <div class="card-middle">
          <h3 class="quadrant-title">{{ q2_title|default("Agente de IA PEBAI") }}</h3>
          <p class="quadrant-desc">{{ q2_desc|default("Atiende en 12 segundos 24/7, cualifica y sincroniza la cita en tu CRM.") }}</p>
        </div>
        <div class="card-bottom">
          <div>
            <div class="metric-chip">{{ q2_metric|default("12 Segundos") }}</div>
            <div class="metric-sub">{{ q2_metric_sub|default("24/7 ACTIVO") }}</div>
          </div>
          <div style="font-size: 13px; font-weight: 800; color: #B7FF3C;">+35% Conversión</div>
        </div>
      </div>

      <!-- Q3: Bottom-Left (Obsoleto) -->
      <div class="quadrant-card">
        <div class="card-top">
          <span class="quadrant-badge">{{ q3_badge|default("Obsoleto") }}</span>
          <div class="card-icon">{{ q3_icon_svg|safe }}</div>
        </div>
        <div class="card-middle">
          <h3 class="quadrant-title">{{ q3_title|default("Buzón de Voz") }}</h3>
          <p class="quadrant-desc">{{ q3_desc|default("El cliente cuelga a los 4 tonos y compra al primer competidor.") }}</p>
        </div>
        <div class="card-bottom">
          <div>
            <div class="metric-chip">{{ q3_metric|default("> 14 Horas") }}</div>
            <div class="metric-sub">{{ q3_metric_sub|default("Pérdida") }}</div>
          </div>
          <div style="font-size: 12px; font-weight: 700; color: #a81b1b;">0% Conversión</div>
        </div>
      </div>

      <!-- Q4: Bottom-Right (Software Incompleto) -->
      <div class="quadrant-card">
        <div class="card-top">
          <span class="quadrant-badge">{{ q4_badge|default("Incompleto") }}</span>
          <div class="card-icon">{{ q4_icon_svg|safe }}</div>
        </div>
        <div class="card-middle">
          <h3 class="quadrant-title">{{ q4_title|default("Software Genérico") }}</h3>
          <p class="quadrant-desc">{{ q4_desc|default("Licencias caras que nadie utiliza por falta de integración en procesos.") }}</p>
        </div>
        <div class="card-bottom">
          <div>
            <div class="metric-chip">{{ q4_metric|default("Sin uso") }}</div>
            <div class="metric-sub">{{ q4_metric_sub|default("Gasto") }}</div>
          </div>
          <div style="font-size: 12px; font-weight: 700; color: #71707B;">ROI Negativo</div>
        </div>
      </div>
    </div>

    <div class="axis-x-label">
      <span>Nivel de Automatización: Manual</span>
      <span>Automatización Autónoma con IA →</span>
    </div>
  </div>

  <!-- Footer with official SVG logo -->
  <div class="footer-section">
    <div class="footer-brand">
      <img src="{{ assets_uri }}/pebai/pebai-horizontal-dark.svg" alt="PEBAI Systems">
    </div>
    <div class="footer-note">{{ footer_web|default("pebaisystems.es") }}</div>
    <div class="footer-cta">
      <span>{{ footer_cta|default("Desliza para ver la solución") }}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#12121A" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>
  </div>
</body>
</html>
