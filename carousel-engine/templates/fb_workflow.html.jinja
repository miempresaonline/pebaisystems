<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ main_title|default("Workflow Pipeline") }} - PEBAI Systems</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      width: 1080px;
      height: 1440px;
      background-color: #EFEDE7; /* Official PEBAI Mineral White */
      color: #12121A;
      font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 60px 65px;
      -webkit-font-smoothing: antialiased;
    }

    /* Subtle background grid */
    body::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(18, 18, 26, 0.05) 1.2px, transparent 0);
      background-size: 30px 30px;
      pointer-events: none;
      z-index: 1;
    }

    /* Header */
    .slide-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      position: relative;
      z-index: 2;
    }

    .badge-topic {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #555562;
    }

    .topic-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #B7FF3C;
      box-shadow: 0 0 10px #B7FF3C;
    }

    .slide-index {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: #12121A;
      background: rgba(18, 18, 26, 0.06);
      padding: 6px 14px;
      border-radius: 20px;
    }

    /* Hook Title */
    .hook-section {
      text-align: center;
      margin-top: 10px;
      position: relative;
      z-index: 2;
    }

    .tag-small {
      display: inline-block;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #6A5CFF;
      margin-bottom: 12px;
    }

    .main-title {
      font-size: 64px;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.08;
      text-transform: uppercase;
      color: #12121A;
    }

    .main-title span {
      color: #12121A;
      position: relative;
      display: inline-block;
    }

    .main-title span::after {
      content: "";
      position: absolute;
      left: -4px;
      right: -4px;
      bottom: 6px;
      height: 14px;
      background: #B7FF3C;
      z-index: -1;
      border-radius: 4px;
    }

    /* Visual Pipeline */
    .pipeline-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      width: 100%;
      max-width: 880px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    /* Flow Card */
    .flow-card {
      width: 100%;
      background: #FFFFFF;
      border: 1.5px solid #12121A;
      border-radius: 22px;
      padding: 24px 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 8px 0 #12121A;
      position: relative;
    }

    .flow-card.hero-step {
      background: #12121A;
      border-color: #B7FF3C;
      box-shadow: 0 10px 0 #000000, 0 20px 40px rgba(183, 255, 60, 0.18);
    }

    .card-left {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .card-icon-box {
      width: 64px;
      height: 64px;
      border-radius: 16px;
      background: #F1F0ED;
      border: 1px solid rgba(18, 18, 26, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .card-icon-box svg {
      width: 32px;
      height: 32px;
    }

    .card-info h3 {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #12121A;
      margin-bottom: 4px;
    }

    .card-info p {
      font-size: 16px;
      font-weight: 500;
      color: #646470;
    }

    .card-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 15px;
      font-weight: 700;
      background: #F1F0ED;
      color: #12121A;
      border: 1px solid rgba(18, 18, 26, 0.12);
      padding: 8px 16px;
      border-radius: 12px;
      flex-shrink: 0;
    }

    /* Hero Step overrides */
    .flow-card.hero-step .card-icon-box {
      background: #000000;
      border: 1px solid rgba(183, 255, 60, 0.35);
      padding: 12px;
    }

    .flow-card.hero-step .card-icon-box img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .flow-card.hero-step .card-info h3 {
      color: #FFFFFF;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .flow-card.hero-step .card-info h3::after {
      content: "{{ hero_badge_text|default('CEREBRO AUTÓNOMO') }}";
      font-size: 12px;
      letter-spacing: 0.1em;
      background: #B7FF3C;
      color: #12121A;
      padding: 3px 8px;
      border-radius: 6px;
    }

    .flow-card.hero-step .card-info p {
      color: #B7FF3C;
    }

    .flow-card.hero-step .card-badge {
      background: #B7FF3C;
      color: #12121A;
      font-weight: 800;
      border: none;
      box-shadow: 0 4px 15px rgba(183, 255, 60, 0.3);
    }

    /* Vertical connector arrow */
    .flow-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: #FFFFFF;
      border: 1px solid rgba(18, 18, 26, 0.1);
      box-shadow: 0 4px 12px rgba(18, 18, 26, 0.05);
      color: #12121A;
    }

    .flow-arrow svg {
      width: 18px;
      height: 18px;
    }

    /* Bottom Highlight Banner */
    .impact-banner {
      width: 100%;
      max-width: 880px;
      background: linear-gradient(90deg, rgba(183, 255, 60, 0.2), rgba(106, 92, 255, 0.15));
      border: 1.5px solid #12121A;
      border-radius: 20px;
      padding: 18px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      z-index: 2;
    }

    .impact-banner span {
      font-size: 20px;
      font-weight: 800;
      color: #12121A;
      letter-spacing: -0.02em;
    }

    .impact-banner .impact-pill {
      background: #12121A;
      color: #B7FF3C !important;
      font-size: 15px;
      font-weight: 800;
      padding: 8px 18px;
      border-radius: 30px;
      letter-spacing: 0.04em;
    }

    /* Footer */
    .slide-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding-top: 24px;
      border-top: 1px solid rgba(18, 18, 26, 0.12);
      position: relative;
      z-index: 2;
    }

    .brand-id {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-id img {
      width: 32px;
      height: 32px;
      object-fit: contain;
    }

    .brand-name {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #12121A;
    }

    .brand-name span {
      font-weight: 400;
      color: #646470;
      margin-left: 4px;
    }

    .web-url {
      font-size: 18px;
      font-weight: 600;
      color: #555562;
    }

    .swipe-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #E2DFD7;
      padding: 10px 20px;
      border-radius: 24px;
      font-size: 16px;
      font-weight: 700;
      color: #12121A;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header class="slide-header">
    <div class="badge-topic">
      <div class="topic-dot"></div>
      <span>{{ topic_tag|default("SISTEMA AUTÓNOMO · PEBAI") }}</span>
    </div>
    <div class="slide-index">{{ slide_number|default(1) }} / {{ total_slides|default(3) }}</div>
  </header>

  <!-- Hook Question -->
  <section class="hook-section">
    <span class="tag-small">{{ sub_tag|default("Pipeline Operativo") }}</span>
    <h1 class="main-title">
      {{ title_line1|default("CÓMO CONTESTA TU NEGOCIO") }}<br><span>{{ title_highlight|default("A LAS 21:00 HORAS") }}</span>
    </h1>
  </section>

  <!-- Center Visual Pipeline -->
  <section class="pipeline-container">
    
    <!-- Step 1: Input -->
    <div class="flow-card">
      <div class="card-left">
        <div class="card-icon-box">
          {{ step1_icon_svg|default('<svg viewBox="0 0 24 24" fill="none" stroke="#12121A" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>')|safe }}
        </div>
        <div class="card-info">
          <h3>{{ step1_title|default("Lead Entrante por WhatsApp") }}</h3>
          <p>{{ step1_desc|default("Cliente potencial pide presupuesto de urgencia") }}</p>
        </div>
      </div>
      <span class="card-badge">{{ step1_badge|default("21:02:14") }}</span>
    </div>

    <!-- Arrow -->
    <div class="flow-arrow">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <polyline points="19 12 12 19 5 12"></polyline>
      </svg>
    </div>

    <!-- Step 2: PEBAI Agent Hero -->
    <div class="flow-card hero-step">
      <div class="card-left">
        <div class="card-icon-box">
          <img src="{{ assets_uri }}/pebai/pebai-mark-color.svg" alt="PEBAI Logo">
        </div>
        <div class="card-info">
          <h3>{{ step2_title|default("Agente de IA PEBAI") }}</h3>
          <p>{{ step2_desc|default("Cualifica necesidades, consulta catálogo y genera tarifa") }}</p>
        </div>
      </div>
      <span class="card-badge">{{ step2_badge|default("12 Seg") }}</span>
    </div>

    <!-- Arrow -->
    <div class="flow-arrow">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <polyline points="19 12 12 19 5 12"></polyline>
      </svg>
    </div>

    <!-- Step 3: Calendar & CRM -->
    <div class="flow-card">
      <div class="card-left">
        <div class="card-icon-box">
          {{ step3_icon_svg|default('<svg viewBox="0 0 24 24" fill="none" stroke="#12121A" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>')|safe }}
        </div>
        <div class="card-info">
          <h3>{{ step3_title|default("Cita Cerrada en Google Calendar") }}</h3>
          <p>{{ step3_desc|default("Presupuesto enviado en PDF + sincronizado en CRM") }}</p>
        </div>
      </div>
      <span class="card-badge">{{ step3_badge|default("21:02:40") }}</span>
    </div>

  </section>

  <!-- Impact Callout -->
  <div class="impact-banner">
    <span>{{ impact_text|default("De 14 horas de espera al día siguiente a 26 segundos") }}</span>
    <span class="impact-pill">{{ impact_pill|default("0% Error Humano") }}</span>
  </div>

  <!-- Slide Footer -->
  <footer class="slide-footer">
    <div class="brand-id">
      <img src="{{ assets_uri }}/pebai/pebai-horizontal-dark.svg" alt="PEBAI Systems" style="height: 32px; width: auto;">
    </div>
    <div class="web-url">{{ footer_web|default("pebaisystems.es") }}</div>
    <div class="swipe-pill">
      <span>{{ footer_cta|default("Desliza para ver la demo") }}</span>
      <span style="font-size: 18px;">&rarr;</span>
    </div>
  </footer>

</body>
</html>
