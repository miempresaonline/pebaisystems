    <div style="background: #0D0E15; border: 2.5px solid #5848FA; border-radius: 28px; padding: 50px 42px; box-shadow: 0 28px 70px rgba(88, 72, 250, 0.32); display: flex; flex-direction: column; align-items: center; gap: 28px;">
      
