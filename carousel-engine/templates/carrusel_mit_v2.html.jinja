          <div style="background: #B7FF3C; color: #0D0E15; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 900; padding: 6px 14px; border-radius: 8px; text-transform: uppercase;">
            100% BONIFICADA
          </div>
          <div style="font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 800; color: #5848FA; margin-top: 10px;">
            SOLO 5 PLAZAS
          </div>
        </div>
      </div>

      <!-- Ticket Footer -->
      <div style="padding: 22px 32px; background: #FFFFFF; display: flex; justify-content: space-between; align-items: center;">
        <span style="font-size: 18.5px; font-weight: 700; color: #4A4843;">
