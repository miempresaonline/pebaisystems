        <div style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #FAF9F6; font-family: 'JetBrains Mono', monospace; font-size: 15px; font-weight: 700; padding: 12px 20px; border-radius: 999px;">
