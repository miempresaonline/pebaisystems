              <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 800; color: #16A34A;">EN VIVO</span>
            </div>
            <div class="dash-checklist-item">
              <span>✓ Presupuestos sincronizados con CRM y contabilidad</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 800; color: #5848FA;">AUTOMÁTICO</span>
            </div>
            <div class="dash-checklist-item">
              <span>✓ 0 horas perdidas en tareas manuales repetitivas</span>
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 800; color: #16A34A;">100% MARGEN</span>
            </div>
          </div>

          <!-- 4 Metric Cards with Mini Trends -->
          <div class="dash-metrics-grid">
            <div class="dash-metric-box">
              <div class="dash-metric-label">Ventas / Mes</div>
              <div class="dash-metric-val">$14.8K</div>
              <div class="dash-metric-trend">↑ +28%</div>
            </div>
            <div class="dash-metric-box">
              <div class="dash-metric-label">Horas Ahorradas</div>
              <div class="dash-metric-val">18.5h</div>
              <div class="dash-metric-trend">↑ / sem</div>
            </div>
            <div class="dash-metric-box">
              <div class="dash-metric-label">Clientes CRM</div>
              <div class="dash-metric-val">184</div>
              <div class="dash-metric-trend">↑ +14</div>
            </div>
            <div class="dash-metric-box">
              <div class="dash-metric-label">Operativa</div>
              <div class="dash-metric-val">100%</div>
              <div class="dash-metric-trend">0 errores</div>
            </div>
          </div>

        </div>

      </div>
    </div>

    <div class="takeaway-footer-note">
      Todo lo que importa. En un solo lugar.
    </div>
    {% endif %}

    <!-- ==================== SLIDE 4: IMPLANTACIÓN OPERATIVA REAL ==================== -->
