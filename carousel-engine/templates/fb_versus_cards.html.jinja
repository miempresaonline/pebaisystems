<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ step_title|default("Comparativa Detallada") }} - PEBAI Systems</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      width: 1080px;
      height: 1440px;
      background-color: #F7F5EE;
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      position: relative;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .slide {
      width: 1080px;
      height: 1440px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 70px 75px 60px 75px;
    }

    /* Subtle background grid pattern */
    .bg-pattern {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(18, 18, 26, 0.08) 1.2px, transparent 1.2px);
      background-size: 32px 32px;
      z-index: 1;
    }

    /* Giant Faint Watermark Step Number */
    .step-watermark {
      position: absolute;
      top: 50px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 260px;
      font-weight: 900;
      color: rgba(18, 18, 26, 0.04);
      z-index: 2;
      pointer-events: none;
      letter-spacing: -0.05em;
    }

    /* Header */
    .slide-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      position: relative;
      z-index: 10;
    }

    .badge-topic {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #FFFFFF;
      border: 1px solid #D8D4C8;
      border-radius: 999px;
      padding: 10px 22px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #12121A;
      box-shadow: 0 4px 12px rgba(18, 18, 26, 0.04);
    }

    .badge-topic::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #594AF7;
    }

    .badge-pagination {
      font-size: 14px;
      font-weight: 800;
      color: #71707B;
      background: #FFFFFF;
      padding: 8px 16px;
      border-radius: 12px;
      border: 1px solid #D8D4C8;
    }

    /* Title Block */
    .title-block {
      text-align: center;
      margin-top: 30px;
      margin-bottom: 30px;
      position: relative;
      z-index: 10;
    }

    .category-label {
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #594AF7;
      margin-bottom: 8px;
    }

    .main-title {
      font-size: 52px;
      font-weight: 900;
      line-height: 1.12;
      letter-spacing: -0.03em;
      color: #12121A;
    }

    /* Comparison Cards Container */
    .cards-container {
      display: flex;
      flex-direction: column;
      gap: 32px;
      width: 100%;
      position: relative;
      z-index: 10;
    }

    /* Individual Comparison Card */
    .compare-card {
      background: #FFFFFF;
      border-radius: 28px;
      padding: 36px 40px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 16px 40px rgba(18, 18, 26, 0.06);
    }

    /* Card 1: Traditional Bottleneck */
    .compare-card.card-manual {
      border: 2px solid #FCA5A5;
      background: linear-gradient(180deg, #FFFFFF 0%, #FFF5F5 100%);
    }

    /* Ribbon Tag */
    .card-ribbon {
      position: absolute;
      top: -16px;
      left: 36px;
      padding: 8px 20px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .ribbon-red {
      background: #EF4444;
      color: #FFFFFF;
      box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);
    }

    /* Card 2: PEBAI AI Autonomous Hero */
    .compare-card.card-pebai {
      border: 2px solid #84CC16;
      background: #12121A;
      color: #FFFFFF;
      box-shadow: 0 24px 50px rgba(18, 18, 26, 0.22), 0 0 35px rgba(183, 255, 60, 0.18);
    }

    .ribbon-green {
      background: #B7FF3C;
      color: #12121A;
      box-shadow: 0 4px 14px rgba(183, 255, 60, 0.45);
    }

    /* Left Info */
    .card-left {
      max-width: 580px;
    }

    .card-title {
      font-size: 34px;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 8px;
    }

    .card-desc {
      font-size: 19px;
      line-height: 1.35;
      font-weight: 500;
      color: #555460;
      margin-bottom: 16px;
    }

    .card-pebai .card-desc {
      color: #A3A3B2;
    }

    .card-meta-row {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .metric-pill {
      font-size: 20px;
      font-weight: 900;
      padding: 6px 16px;
      border-radius: 10px;
      display: inline-block;
    }

    .pill-red {
      background: #FEE2E2;
      color: #DC2626;
    }

    .pill-lime {
      background: #B7FF3C;
      color: #12121A;
    }

    .meta-note {
      font-size: 14px;
      font-weight: 700;
      color: #71707B;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .card-pebai .meta-note {
      color: #B7FF3C;
    }

    /* Right 3D App Tile */
    .card-right-tile {
      width: 140px;
      height: 140px;
      border-radius: 34px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15), 0 4px 10px rgba(255, 255, 255, 0.5) inset;
    }

    .tile-slow {
      background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%);
      border: 1px solid #D1D5DB;
    }

    .tile-fast {
      background: linear-gradient(135deg, #1F202B 0%, #0F1015 100%);
      border: 2px solid #B7FF3C;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 25px rgba(183, 255, 60, 0.35);
    }

    /* Footer */
    .slide-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding-top: 24px;
      border-top: 1px solid rgba(18, 18, 26, 0.12);
      position: relative;
      z-index: 10;
    }

    .brand-id {
      display: flex;
      align-items: center;
    }

    .web-url {
      font-size: 15px;
      font-weight: 600;
      color: #71707B;
      letter-spacing: 0.05em;
    }

    .swipe-pill {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #12121A;
      color: #FFFFFF;
      font-size: 14px;
      font-weight: 800;
      padding: 12px 24px;
      border-radius: 999px;
      box-shadow: 0 8px 24px rgba(18, 18, 26, 0.15);
    }
  </style>
</head>
<body>

  <div class="slide">
    <div class="bg-pattern"></div>
    <div class="step-watermark">{{ step_number|default("01") }}</div>

    <!-- Header -->
    <header class="slide-header">
      <div class="badge-topic">{{ topic_badge|default("CANAL: WHATSAPP Y LLAMADAS") }}</div>
      <div class="badge-pagination">{{ slide_number|default(2) }} / {{ total_slides|default(5) }}</div>
    </header>

    <!-- Title Block -->
    <div class="title-block">
      <div class="category-label">{{ step_category|default("TIEMPO DE RESPUESTA A LEADS") }}</div>
      <h2 class="main-title">{{ step_title|default("Atención Inmediata al Primer Tono") }}</h2>
    </div>

    <!-- Comparison Cards -->
    <div class="cards-container">
      <!-- Manual Card -->
      <div class="compare-card card-manual">
        <div class="card-ribbon ribbon-red">{{ manual_ribbon|default("Proceso Manual") }}</div>
        <div class="card-left">
          <h3 class="card-title" style="color: #991B1B;">{{ manual_title|default("Centralita / Secretaría") }}</h3>
          <p class="card-desc">{{ manual_desc|default("Líneas comunicando a deshora, notas en papel y el cliente cuelga para llamar a la competencia.") }}</p>
          <div class="card-meta-row">
            <span class="metric-pill pill-red">{{ manual_metric|default("> 4 Horas") }}</span>
            <span class="meta-note">{{ manual_note|default("60% Fuga de clientes") }}</span>
          </div>
        </div>
        <div class="card-right-tile tile-slow">
          <svg width="68" height="68" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </div>
      </div>

      <!-- PEBAI Card -->
      <div class="compare-card card-pebai">
        <div class="card-ribbon ribbon-green">{{ pebai_ribbon|default("100% Autónomo") }}</div>
        <div class="card-left">
          <h3 class="card-title" style="color: #FFFFFF;">{{ pebai_title|default("Agente IA PEBAI Systems") }}</h3>
          <p class="card-desc">{{ pebai_desc|default("Descuelga en 12 segundos, cualifica los requerimientos técnicos y agenda la reunión en Google Calendar.") }}</p>
          <div class="card-meta-row">
            <span class="metric-pill pill-lime">{{ pebai_metric|default("12 Segundos") }}</span>
            <span class="meta-note">{{ pebai_note|default("24/7 Activo · 0 llamadas perdidas") }}</span>
          </div>
        </div>
        <div class="card-right-tile tile-fast">
          <img src="{{ assets_uri }}/pebai/pebai-mark-color.svg" alt="PEBAI Wave" style="width: 72px; height: 72px;">
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="slide-footer">
      <div class="brand-id">
        <img src="{{ assets_uri }}/pebai/pebai-horizontal-dark.svg" alt="PEBAI Systems" style="height: 32px; width: auto;">
      </div>
      <div class="web-url">{{ footer_web|default("pebaisystems.es") }}</div>
      <div class="swipe-pill">
        <span>{{ footer_cta|default("Desliza para ver el siguiente caso") }}</span>
        <span style="font-size: 16px;">&rarr;</span>
      </div>
    </footer>
  </div>

</body>
</html>
