<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ title_line1 }} - PEBAI Systems</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      width: 1080px;
      height: 1440px;
      background-color: #EFEDE7;
      color: #12121A;
      font-family: 'Manrope', -apple-system, sans-serif;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 70px 75px 55px 75px;
      -webkit-font-smoothing: antialiased;
    }

    .noise-overlay {
      position: absolute;
      inset: 0;
      opacity: 0.045;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      z-index: 10;
    }

    .top-meta {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 2;
    }

    .meta-tag {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #55545E;
    }

    .meta-pagination {
      font-size: 13px;
      font-weight: 800;
      color: #12121A;
      background: #E2DFD6;
      padding: 6px 14px;
      border-radius: 20px;
    }

    .header-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      z-index: 2;
      margin-top: 15px;
    }

    .category-icon-pill {
      width: 48px;
      height: 48px;
      background: #12121A;
      color: #B7FF3C;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      padding: 10px;
    }

    .category-icon-pill svg {
      width: 100%;
      height: 100%;
    }

    .main-title {
      font-size: 54px;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.08;
      text-transform: uppercase;
      color: #12121A;
      max-width: 900px;
    }

    .main-title span.highlight {
      color: #594AF7;
    }

    /* Node Graph Area */
    .nodes-container {
      width: 100%;
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 25px;
    }

    .node-card {
      width: 100%;
      background: #FFFFFF;
      border: 1px solid #D8D4C8;
      border-radius: 22px;
      padding: 24px 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      box-shadow: 0 4px 14px rgba(18, 18, 26, 0.04);
    }

    .node-card.hero-node {
      background: #12121A;
      color: #FFFFFF;
      border: 2px solid #B7FF3C;
      box-shadow: 0 16px 45px rgba(18, 18, 26, 0.22), 0 0 25px rgba(183, 255, 60, 0.15);
    }

    .node-left {
      display: flex;
      align-items: center;
      gap: 20px;
      width: 70%;
    }

    .node-icon-box {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: #F3F1EC;
      color: #12121A;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px;
      flex-shrink: 0;
    }

    .hero-node .node-icon-box {
      background: rgba(183, 255, 60, 0.2);
      color: #B7FF3C;
    }

    .node-icon-box svg {
      width: 100%;
      height: 100%;
    }

    .node-texts {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .node-step-label {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #71707B;
    }

    .hero-node .node-step-label {
      color: #B7FF3C;
    }

    .node-title {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: #12121A;
    }

    .hero-node .node-title {
      color: #FFFFFF;
    }

    .node-desc {
      font-size: 14px;
      font-weight: 500;
      color: #55545E;
      line-height: 1.3;
    }

    .hero-node .node-desc {
      color: #AFAEB9;
    }

    .node-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
    }

    .node-badge {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      padding: 6px 14px;
      border-radius: 20px;
      background: #F2EFE8;
      color: #12121A;
      text-transform: uppercase;
    }

    .hero-node .node-badge {
      background: #B7FF3C;
      color: #12121A;
      font-weight: 800;
      box-shadow: 0 4px 14px rgba(183, 255, 60, 0.3);
    }

    /* Node Connectors */
    .node-connector {
      height: 48px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .connector-line {
      width: 2px;
      height: 100%;
      background: #C4C0B4;
    }

    .connector-pill {
      position: absolute;
      background: #EFEDE7;
      border: 1px solid #C4C0B4;
      border-radius: 12px;
      padding: 2px 10px;
      font-size: 10px;
      font-weight: 800;
      color: #55545E;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* Bottom 3 Metric Pills */
    .metric-pills-row {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 16px;
      margin-top: 30px;
    }

    .metric-pill-card {
      background: #E5E2DA;
      border-radius: 16px;
      padding: 16px 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 4px;
    }

    .metric-pill-val {
      font-size: 24px;
      font-weight: 800;
      color: #12121A;
      letter-spacing: -0.02em;
    }

    .metric-pill-lbl {
      font-size: 11px;
      font-weight: 700;
      color: #55545E;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* Footer */
    .footer-section {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 2;
      border-top: 1.5px solid #D8D4C8;
      padding-top: 24px;
    }

    .footer-brand {
      display: flex;
      align-items: center;
    }

    .footer-brand img {
      height: 32px;
      width: auto;
    }

    .footer-note {
      font-size: 13px;
      font-weight: 700;
      color: #71707B;
    }

    .footer-cta {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 800;
      color: #12121A;
      background: #FFFFFF;
      padding: 10px 18px;
      border-radius: 30px;
      border: 1px solid #D8D4C8;
    }
  </style>
</head>
<body>
  <div class="noise-overlay"></div>

  <!-- Meta Pagination -->
  <div class="top-meta">
    <span class="meta-tag">{{ topic_tag|default("PIPELINE OPERATIVO · PEBAI") }}</span>
    {% if slide_number and total_slides %}
    <span class="meta-pagination">{{ slide_number }}/{{ total_slides }}</span>
    {% endif %}
  </div>

  <!-- Header -->
  <div class="header-container">
    <div class="category-icon-pill">
      {{ category_icon_svg|safe }}
    </div>
    <h1 class="main-title">{{ title_line1 }} <span class="highlight">{{ title_highlight }}</span></h1>
  </div>

  <!-- Connected Nodes Flow -->
  <div class="nodes-container">
    <!-- Node 1: Input -->
    <div class="node-card">
      <div class="node-left">
        <div class="node-icon-box">{{ step1_icon_svg|safe }}</div>
        <div class="node-texts">
          <span class="node-step-label">Paso 01 · Canal de Entrada</span>
          <h3 class="node-title">{{ step1_title|default("Lead Entrante por WhatsApp") }}</h3>
          <p class="node-desc">{{ step1_desc|default("El cliente pide presupuesto y disponibilidad a las 21:04 PM") }}</p>
        </div>
      </div>
      <div class="node-right">
        <span class="node-badge">{{ step1_badge|default("21:04:00") }}</span>
      </div>
    </div>

    <!-- Connector 1 -->
    <div class="node-connector">
      <div class="connector-line"></div>
      <span class="connector-pill">Disparo de IA en 0.2s</span>
    </div>

    <!-- Node 2: HERO AI Brain -->
    <div class="node-card hero-node">
      <div class="node-left">
        <div class="node-icon-box">{{ step2_icon_svg|safe }}</div>
        <div class="node-texts">
          <span class="node-step-label">Paso 02 · Cerebro Autónomo PEBAI</span>
          <h3 class="node-title">{{ step2_title|default("Agente de IA Cualifica y Cotiza") }}</h3>
          <p class="node-desc">{{ step2_desc|default("Consulta tarifas, valida stock y genera propuesta formal en PDF") }}</p>
        </div>
      </div>
      <div class="node-right">
        <span class="node-badge">{{ step2_badge|default("12 Segundos") }}</span>
      </div>
    </div>

    <!-- Connector 2 -->
    <div class="node-connector">
      <div class="connector-line"></div>
      <span class="connector-pill">Sincronización en CRM</span>
    </div>

    <!-- Node 3: Output -->
    <div class="node-card">
      <div class="node-left">
        <div class="node-icon-box">{{ step3_icon_svg|safe }}</div>
        <div class="node-texts">
          <span class="node-step-label">Paso 03 · Cierre Comercial</span>
          <h3 class="node-title">{{ step3_title|default("Cita Cerrada en Google Calendar") }}</h3>
          <p class="node-desc">{{ step3_desc|default("Propuesta entregada al cliente y reunión agendada en la agenda") }}</p>
        </div>
      </div>
      <div class="node-right">
        <span class="node-badge">{{ step3_badge|default("21:04:26") }}</span>
      </div>
    </div>

    <!-- Metric Summary Row -->
    <div class="metric-pills-row">
      <div class="metric-pill-card">
        <div class="metric-pill-val">26 Seg</div>
        <div class="metric-pill-lbl">Tiempo Total</div>
      </div>
      <div class="metric-pill-card">
        <div class="metric-pill-val" style="color:#594AF7;">0% Fallos</div>
        <div class="metric-pill-lbl">Error Humano</div>
      </div>
      <div class="metric-pill-card">
        <div class="metric-pill-val" style="color:#15803d;">24/7/365</div>
        <div class="metric-pill-lbl">Disponibilidad</div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="footer-section">
    <div class="footer-brand">
      <img src="{{ assets_uri }}/pebai/pebai-horizontal-dark.svg" alt="PEBAI Systems">
    </div>
    <div class="footer-note">{{ footer_web|default("pebaisystems.es") }}</div>
    <div class="footer-cta">
      <span>{{ footer_cta|default("Desliza para ver la demo") }}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#12121A" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>
  </div>
</body>
</html>
