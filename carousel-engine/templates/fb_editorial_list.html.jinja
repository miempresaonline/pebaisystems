<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ module_title|default("Módulo Detallado") }} - PEBAI Systems</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      width: 1080px;
      height: 1440px;
      background-color: #F8F7F2;
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      position: relative;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .slide {
      width: 1080px;
      height: 1440px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 70px 75px 60px 75px;
    }

    .bg-dots {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(#D6D3C7 1.2px, transparent 1.2px);
      background-size: 28px 28px;
      z-index: 1;
      opacity: 0.65;
    }

    /* Top Pagination and Handle */
    .top-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      position: relative;
      z-index: 10;
    }

    .top-handle {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 16px;
      font-weight: 700;
      color: #71707B;
    }

    .top-handle .handle-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #594AF7;
    }

    .step-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 700;
      color: #71707B;
      background: #EAE6D9;
      padding: 6px 14px;
      border-radius: 8px;
      letter-spacing: 0.05em;
    }

    /* Module Headline Area */
    .module-headline {
      margin-top: 25px;
      position: relative;
      z-index: 10;
    }

    .module-title {
      font-family: 'Instrument Serif', Georgia, serif;
      font-size: 72px;
      line-height: 1.05;
      font-weight: 400;
      color: #12121A;
      letter-spacing: -0.02em;
    }

    .module-title em {
      font-style: italic;
      color: #594AF7;
    }

    .module-desc {
      font-size: 22px;
      line-height: 1.35;
      color: #12121A;
      font-weight: 600;
      margin-top: 10px;
      max-width: 820px;
    }

    /* Category Navigation Tabs */
    .category-tabs {
      display: flex;
      gap: 10px;
      width: 100%;
      margin-top: 25px;
      position: relative;
      z-index: 10;
    }

    .tab-pill {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 8px 18px;
      border-radius: 999px;
      background: #EAE6D9;
      color: #71707B;
    }

    .tab-pill.active {
      background: #594AF7;
      color: #FFFFFF;
      box-shadow: 0 4px 14px rgba(89, 74, 247, 0.3);
    }

    /* List of Skills / Tasks */
    .skills-card-list {
      background: #FFFFFF;
      border: 1px solid #D8D4C8;
      border-radius: 28px;
      padding: 24px 32px;
      box-shadow: 0 12px 35px rgba(18, 18, 26, 0.05);
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-top: 20px;
    }

    .skill-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(18, 18, 26, 0.06);
    }

    .skill-item-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .item-left {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .circle-badge {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: #12121A;
      color: #FFFFFF;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .item-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .item-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 800;
      color: #12121A;
      letter-spacing: -0.01em;
    }

    .item-sub {
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #594AF7;
    }

    .item-explain {
      font-size: 16px;
      color: #555460;
      font-weight: 500;
    }

    .item-number {
      font-family: 'Instrument Serif', Georgia, serif;
      font-style: italic;
      font-size: 32px;
      color: #594AF7;
      opacity: 0.85;
    }

    /* Footer */
    .slide-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding-top: 24px;
      border-top: 1px solid rgba(18, 18, 26, 0.12);
      position: relative;
      z-index: 10;
    }

    .brand-id {
      display: flex;
      align-items: center;
    }

    .swipe-text {
      font-size: 18px;
      font-weight: 800;
      color: #12121A;
      display: flex;
      align-items: center;
      gap: 8px;
    }
  </style>
</head>
<body>

  <div class="slide">
    <div class="bg-dots"></div>

    <!-- Top Meta -->
    <header class="top-meta-row">
      <div class="top-handle">
        <span class="handle-dot"></span>
        <span>{{ top_handle|default("@pebaisystems.es") }}</span>
      </div>
      <div class="step-badge">{{ step_counter|default("02 / 05 — AGENTE 1 DE 4") }}</div>
    </header>

    <!-- Module Headline -->
    <div class="module-headline">
      <h2 class="module-title">{{ module_line1|default("El Agente de") }} <em>{{ module_highlight|default("WhatsApp.") }}</em></h2>
      <p class="module-desc">{{ module_desc|default("Cualifica requerimientos técnicos, cotiza tarifas y agenda en tu calendario en 12 segundos. Sin intervención manual.") }}</p>
    </div>

    <!-- Tabs -->
    <div class="category-tabs">
      <div class="tab-pill active">WHATSAPP</div>
      <div class="tab-pill">LLAMADAS</div>
      <div class="tab-pill">PRESUPUESTOS</div>
      <div class="tab-pill">CRM SYNC</div>
    </div>

    <!-- Modular Skill Breakdown -->
    <div class="skills-card-list">
      <div class="skill-item-row">
        <div class="item-left">
          <div class="circle-badge">12s</div>
          <div class="item-info">
            <div class="item-name">whatsapp-instant-qualify</div>
            <div class="item-sub">El filtro comercial</div>
            <div class="item-explain">Detecta el servicio exacto que busca el cliente y descarta curiosos al instante.</div>
          </div>
        </div>
        <div class="item-number">01</div>
      </div>

      <div class="skill-item-row">
        <div class="item-left">
          <div class="circle-badge">pdf</div>
          <div class="item-info">
            <div class="item-name">quote-generator-instant</div>
            <div class="item-sub">El cotizador</div>
            <div class="item-explain">Genera una estimación automática en PDF según los datos del cliente.</div>
          </div>
        </div>
        <div class="item-number">02</div>
      </div>

      <div class="skill-item-row">
        <div class="item-left">
          <div class="circle-badge">cal</div>
          <div class="item-info">
            <div class="item-name">google-calendar-booking</div>
            <div class="item-sub">El cerrador de citas</div>
            <div class="item-explain">Ofrece tus huecos libres y reserva la videollamada sin emails de ida y vuelta.</div>
          </div>
        </div>
        <div class="item-number">03</div>
      </div>

      <div class="skill-item-row">
        <div class="item-left">
          <div class="circle-badge">crm</div>
          <div class="item-info">
            <div class="item-name">hubspot-sync-pipeline</div>
            <div class="item-sub">El integrador</div>
            <div class="item-explain">Crea el contacto, actualiza el deal y sube la grabación para tu equipo.</div>
          </div>
        </div>
        <div class="item-number">04</div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="slide-footer">
      <div class="brand-id">
        <img src="{{ assets_uri }}/pebai/pebai-horizontal-dark.svg" alt="PEBAI Systems" style="height: 32px; width: auto;">
      </div>
      <div class="swipe-text">
        <span>{{ swipe_label|default("desliza") }}</span>
        <span>&rarr;</span>
      </div>
    </footer>
  </div>

</body>
</html>
