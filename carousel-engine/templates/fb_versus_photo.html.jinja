<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ main_title|default("Manual vs IA") }} - PEBAI Systems</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      width: 1080px;
      height: 1440px;
      background-color: #0E0F14;
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      position: relative;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .slide {
      width: 1080px;
      height: 1440px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 70px 75px 60px 75px;
    }

    /* Background Real Photo with dark overlay */
    .bg-photo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
      z-index: 1;
      filter: brightness(0.68) contrast(1.08);
    }

    /* Cinematic Gradient Vignette */
    .gradient-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(10, 11, 16, 0.85) 0%,
        rgba(10, 11, 16, 0.35) 30%,
        rgba(10, 11, 16, 0.45) 55%,
        rgba(10, 11, 16, 0.95) 85%,
        #0A0B10 100%
      );
      z-index: 2;
    }

    /* Subtle grid dots on top */
    .grid-dots {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1.2px, transparent 1.2px);
      background-size: 32px 32px;
      z-index: 3;
      opacity: 0.6;
    }

    /* Header */
    .slide-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      position: relative;
      z-index: 10;
    }

    .badge-topic {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 999px;
      padding: 10px 22px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #FFFFFF;
    }

    .badge-topic::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #B7FF3C;
      box-shadow: 0 0 10px #B7FF3C;
    }

    .badge-pagination {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: rgba(255, 255, 255, 0.8);
      background: rgba(0, 0, 0, 0.4);
      padding: 8px 16px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    /* Floating 3D App Tiles */
    .floating-tiles {
      position: absolute;
      inset: 0;
      z-index: 5;
      pointer-events: none;
    }

    .tile-3d {
      position: absolute;
      width: 130px;
      height: 130px;
      border-radius: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 24px 50px rgba(0, 0, 0, 0.65), 0 4px 12px rgba(255, 255, 255, 0.25) inset;
    }

    .tile-whatsapp {
      left: 90px;
      top: 260px;
      background: linear-gradient(135deg, #2EE06E 0%, #15A852 100%);
      transform: rotate(-8deg);
      border: 1.5px solid rgba(255, 255, 255, 0.3);
    }

    .tile-pebai {
      right: 90px;
      top: 240px;
      background: linear-gradient(135deg, #1C1D24 0%, #101116 100%);
      transform: rotate(8deg);
      border: 2px solid #B7FF3C;
      box-shadow: 0 24px 50px rgba(0, 0, 0, 0.65), 0 0 30px rgba(183, 255, 60, 0.35);
    }

    .tile-crm {
      right: 80px;
      top: 450px;
      background: linear-gradient(135deg, #594AF7 0%, #3B2BBF 100%);
      transform: rotate(-6deg);
      width: 110px;
      height: 110px;
      border-radius: 28px;
      border: 1.5px solid rgba(255, 255, 255, 0.25);
    }

    /* Main Center Action Area */
    .hero-center {
      position: relative;
      z-index: 10;
      margin-top: auto;
      margin-bottom: 50px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    /* Versus Slanted Pills (Learn E-commerce Style) */
    .versus-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      margin-bottom: 30px;
    }

    .badge-pill {
      font-size: 42px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      padding: 16px 36px;
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transform: skewX(-7deg);
    }

    .badge-left {
      background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%);
      color: #FFFFFF;
      box-shadow: 0 16px 35px rgba(239, 68, 68, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .badge-vs {
      font-size: 32px;
      font-weight: 900;
      font-style: italic;
      color: rgba(255, 255, 255, 0.9);
      text-shadow: 0 4px 12px rgba(0, 0, 0, 0.8);
      letter-spacing: 0.05em;
    }

    .badge-right {
      background: linear-gradient(135deg, #B7FF3C 0%, #85D413 100%);
      color: #0E0F14;
      box-shadow: 0 16px 35px rgba(183, 255, 60, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.6);
    }

    /* Headline & Subhead */
    .hero-title {
      font-size: 56px;
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: #FFFFFF;
      max-width: 880px;
      margin-bottom: 20px;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.9);
    }

    .hero-title span.lime {
      color: #B7FF3C;
      text-shadow: 0 0 25px rgba(183, 255, 60, 0.4);
    }

    .hero-subtitle {
      font-size: 26px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.35;
      max-width: 780px;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
    }

    /* Arrow Doodle */
    .doodle-arrow {
      margin-top: 15px;
      width: 70px;
      height: 40px;
      filter: drop-shadow(0 2px 8px rgba(0,0,0,0.8));
    }

    /* Footer */
    .slide-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      position: relative;
      z-index: 10;
    }

    .brand-id {
      display: flex;
      align-items: center;
    }

    .web-url {
      font-size: 15px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.65);
      letter-spacing: 0.05em;
    }

    .swipe-pill {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #FFFFFF;
      color: #0E0F14;
      font-size: 14px;
      font-weight: 800;
      padding: 12px 24px;
      border-radius: 999px;
      box-shadow: 0 8px 24px rgba(255, 255, 255, 0.2);
    }
  </style>
</head>
<body>

  <div class="slide">
    <!-- Real Stock Photo Background -->
    <img class="bg-photo" src="{{ assets_uri }}/stock/{{ photo_filename|default('stock_man_macbook.jpg') }}" alt="Background Photo">
    <div class="gradient-overlay"></div>
    <div class="grid-dots"></div>

    <!-- Header -->
    <header class="slide-header">
      <div class="badge-topic">{{ topic_badge|default("OPTIMIZACIÓN OPERATIVA · PEBAI") }}</div>
      <div class="badge-pagination">{{ slide_number|default(1) }} / {{ total_slides|default(5) }}</div>
    </header>

    <!-- Floating 3D App Tiles -->
    <div class="floating-tiles">
      <!-- WhatsApp Tile -->
      <div class="tile-3d tile-whatsapp">
        <svg width="68" height="68" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
      </div>

      <!-- PEBAI Autonomous AI Hero Tile -->
      <div class="tile-3d tile-pebai">
        <img src="{{ assets_uri }}/pebai/pebai-mark-color.svg" alt="PEBAI" style="width: 72px; height: 72px;">
      </div>

      <!-- CRM Tile -->
      <div class="tile-3d tile-crm">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
    </div>

    <!-- Center Action Content -->
    <div class="hero-center">
      <!-- Slanted Versus Pills -->
      <div class="versus-container">
        <div class="badge-pill badge-left">{{ pill_left|default("MANUAL") }}</div>
        <div class="badge-vs">vs</div>
        <div class="badge-pill badge-right">{{ pill_right|default("IA PEBAI") }}</div>
      </div>

      <!-- Title Hook -->
      <h1 class="hero-title">{{ title_line1|default("EL SISTEMA QUE AHORRA 20H A LA SEMANA") }} <span class="lime">{{ title_highlight|default("EN TU EMPRESA") }}</span></h1>

      <!-- Subtitle -->
      <p class="hero-subtitle">{{ subtitle|default("Cómo atender llamadas y WhatsApps 24/7 sin contratar personal extra ni perder un solo cliente.") }}</p>

      <!-- Hand-drawn curved arrow -->
      <svg class="doodle-arrow" viewBox="0 0 70 40" fill="none">
        <path d="M 5 15 Q 35 35, 60 22 M 50 14 L 62 23 L 53 32" stroke="#B7FF3C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <!-- Footer -->
    <footer class="slide-footer">
      <div class="brand-id">
        <img src="{{ assets_uri }}/pebai/pebai-horizontal-light.svg" alt="PEBAI Systems" style="height: 32px; width: auto;">
      </div>
      <div class="web-url">{{ footer_web|default("pebaisystems.es") }}</div>
      <div class="swipe-pill">
        <span>{{ footer_cta|default("Desliza para ver la comparativa") }}</span>
        <span style="font-size: 16px;">&rarr;</span>
      </div>
    </footer>
  </div>

</body>
</html>
